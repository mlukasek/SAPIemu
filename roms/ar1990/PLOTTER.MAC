COLR:	DS	1		;aktualni barva

SPD:	DS	1
RTLI:	DS	1

SKUTX:	DS	2		;poloha 0 od poc. papiru v X

PPORG:	DS	1		;druh funkce dorazu
VOLB:	DS	1
				;promenne pro rizeni zvuk.
				;      generatoru
