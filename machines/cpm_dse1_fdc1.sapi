// SAPI-1 machine description, written by the SAPIemu configurator.
// Paths are relative to the emulator data folder (roms/, media/, work/).
{
    "name": "CP/M s programátorem EPROM DSE-1: FDC-1, DSE.COM a EPROM.COM (J. Bíba)",
    "description": "CP/M 2.2 J. Bíby (SAPIMAN) z 8\" diskety A: přes FDC-1 (BIOS V130711JB, jako cpm_boot_fdc1) s deskou DSE-1 Tesla Elstroj na portech F0h-F7h v X7. D: = služební disketa J. Bíby s EPROM.COM (V130786, Z80; programuje 2708, 2716 i 2732; D:EPROM), E: = disketa s DSE.COM J. Hlaváče (2716 a 2732; E:DSE, návod TYPE E:DSECPM.DOC), C: = RAM disk ZRMD-1, B: = CP/M 2.2/P 48K (Peřina) jako datová disketa. JP1 desky DSE-1 je rozpojená: EPROM.COM svítí bitem D5 na LED a MAP1 by pod CP/M přepnul paměť DMR-1. Kabel X2 má dvě patice (2716 a 2732), v nich prázdná 2716; 2708 potřebuje kabel pro 2708 (v okně programátoru Nová 2708, pak tlačítko Změnit kabel X2… u upozornění). Okno Programátor EPROM DSE-1 se otevře při startu. docs/navod-dse1.md (kapitoly 11 a 12), docs/desky/DSE-1.md.",
    "windows": [ "dse1" ],                  // Windows opened on top at the start: media, minigraf, aps5, diag, printer, terminal, ims2, dse1
    "bus": {
        "type": "ARB-1C-8",                 // ARB-1C 8 positions (ZPC)
        "jp3": "2-3"                        // JP3: 2-3 = CPU card in X1, 1-2 = address buffers off (PKT-1)
    },
    "cards": [
        {
            "slot": 1,                      // position X1
            "type": "JPR-1ZI",              // CPU card Z80 (new design)
            "rom": "roms/jpr-1zi/JPR-1ZI_MON130711_JB_FDC.bin",  // EPROM 2764 - MON 130711 J. Biba (CP/M from an 8" disk, FDC-1)
            "decoder": "2k",                // PROM D3C: memory decoder - ROM 0000-07FF (2 KB)
            "cpu_mhz": 2,                   // JP2/JP3: CPU clock - 2 MHz (position 3)
            "bus_mhz": 2,                   // JP2/JP3: bus clock F2 - 2 MHz (position 2)
            "keyboard": { "type": "Consul 259.11", "code": "koi8cs" },  // Keyboard (connector X2)
            "printer": {                    // X3: printer (Centronics cable: data P2-OUT, /STROBE P1-OUT1, BUSY P2-IN6)
                "output": "work/printer/tiskarna.prn",  // Printer: output file (the bytes as received, ESC/P kept)
                "charset": "koi8cs",        // Printer: character set of the text view (80h-FFh) - KOI-8 cs2 (as SAPI)
                "busy_us": 100              // Printer: BUSY after each byte (us; 0 = at once, a deviation)
            }
        },
        {
            "slot": 2,                      // position X2
            "type": "DMR-1",                // 128 KB RAM and serial port
            "battery": false,               // JP7: battery backup of the SRAM
            "ram_config": 1,                // JP3: RAM range - 1: 0000-F7FF (display at F800)
            "uart_base": "10h",             // JP2: UART ports
            "baud": 9600,                   // JP8: baud rate - 9600 Bd
            "connected": false,             // Terminal connected at start (DCD)
            "serial": {
                "pacing": true,             // PC side: no overrun (pacing)
                "tcp": {                    // PC side: TCP server
                    "port": 2323,           // TCP port
                    "bind": "127.0.0.1",    // Address (127.0.0.1 = this PC only)
                    "protocol": "telnet",   // Protocol
                    "dcd_follows": true     // DCD follows the client connection
                }
            }
        },
        {
            "slot": 3,                      // position X3
            "type": "AND-1Z-89",            // Alphanumeric display "Z" 1989
            "map_enabled": false            // S1: MAP1 disconnects the card
        },
        {
            "slot": 4,                      // position X4
            "type": "ZRMD-1",               // RAM disk 4 MB with RTC
            "image": "media/zrmd-1/ZRMD-1_prazdny_OFF0.bin",  // Disk image - empty, CP/M over all 4 MB (systems of J. Biba 2011)
            "mode": "rw",                   // Mode - read/write, saved
            "write_enable": [
                true,                       // S1: write enable, 1st MB
                true,                       // S2: write enable, 2nd MB
                true,                       // S3: write enable, 3rd MB
                true                        // S4: write enable, 4th MB
            ],
            "rtc": true,                    // RTC 72421
            "rtc_int": "none",              // JP3: RTC interrupt
            "map_jp2": false                // JP2: port 63h b6/b7 drive MAP1/MAP2
        },
        {
            "slot": 5,                      // position X5
            "type": "FDC-1",                // Floppy disk controller 8272 + DMA (boards A + B)
            "drive_a": {                    // Drive 0
                "image": "media/sapiman/f1_zrmd4_130711.img",  // Disk image (.img by its size: 8" SS SD, PC 3.5"/5.25" HD/DD; or ImageDisk .imd) - CP/M boot disk J. Biba (MON 130711, C: ZRMD-1)
                "write_protect": false,     // Write protected
                "cpm": "A"                  // CP/M letter of the drive (Media window; empty = seen while running)
            },
            "drive_b": {                    // Drive 1
                "image": "media/rpd-1/CPM22P_48A_Perina.img",  // Disk image (.img by its size: 8" SS SD, PC 3.5"/5.25" HD/DD; or ImageDisk .imd)
                "write_protect": false,     // Write protected
                "cpm": "B"                  // CP/M letter of the drive (Media window; empty = seen while running)
            },
            "drive_c": {                    // Drive 2
                "image": "media/sapiman/knihovna/sysprog_a_sluzebni_CPM.img",  // Disk image (.img by its size: 8" SS SD, PC 3.5"/5.25" HD/DD; or ImageDisk .imd)
                "write_protect": false,     // Write protected
                "cpm": "D"                  // CP/M letter of the drive (Media window; empty = seen while running)
            },
            "drive_d": {                    // Drive 3
                "image": "media/sapiman/knihovna/perina_dse.img",  // Disk image (.img by its size: 8" SS SD, PC 3.5"/5.25" HD/DD; or ImageDisk .imd)
                "write_protect": false,     // Write protected
                "cpm": "E"                  // CP/M letter of the drive (Media window; empty = seen while running)
            },
            "working_copy": true,           // Work on copies in work/
            "decoder": "roms/fdc-1/FDC-1A_D5B_74S287.bin",  // PROM D5B (FDC-1A): port decoder - standard: 8257 04-0BH, 8272 0CH-0DH, FDC-1B 0EH-0FH
            "rdy_ground": true,             // FDC-1A X3-20 /RDY grounded (as supplied, Consul 7113): all drives ready
            "sa2_a": "8sd",                 // FDC-1B switches SA2 S1, S5: drive A - 8" SD (read by IN 0EH: D1 = 1, D0 = 0; 8 MHz: FM 250, MFM 500 kbit/s)
            "sa2_b": "8sd",                 // FDC-1B switches SA2 S2, S6: drive B - 8" SD (read by IN 0EH: D1 = 1, D0 = 0; 8 MHz: FM 250, MFM 500 kbit/s)
            "sa2_c": "8sd",                 // FDC-1B switches SA2 S3, S7: drive C - 8" SD (read by IN 0EH: D1 = 1, D0 = 0; 8 MHz: FM 250, MFM 500 kbit/s)
            "sa2_d": "8sd"                  // FDC-1B switches SA2 S4, S8: drive D - 8" SD (read by IN 0EH: D1 = 1, D0 = 0; 8 MHz: FM 250, MFM 500 kbit/s)
        },
        {
            "slot": 7,                      // position X7
            "type": "DSE-1",                // EPROM simulator and programmer 2716/2732
            "base": "F0h",                  // S1: ports (base+0..3 8255, base+4..7 register) - F0h (S1/1-4: 0 0 0 0, as supplied)
            "jp1_map": false,               // JP1: bit D5 drives MAP1 (pin 21 of X1; open for EPROM.COM of J. Biba, it lights a LED by D5)
            "vpp": "pin50",                 // Programming voltage Vpp (variant) - DSE-1B: +30 V from pin 50 (terminal N of ZDR-1A)
            "x2_cable": "dual",             // Programming cable X2 - two sockets 2716 + 2732 (replica; the EPROM picks its socket)
            "eprom": "media/dse-1/eprom_2716.bin",  // EPROM in the socket of X2 (.bin: 1024 B = 2708, 2048 B = 2716, 4096 B = 2732; a pulse of 1 ms or longer programs, an assumption; a 2708 from 0.1 ms, a byte should get 100 ms in all) - Blank 2716 (2 KB, all FFh)
            "working_copy": true            // Work on copies in work/
        }
    ]
}
