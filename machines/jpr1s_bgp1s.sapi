// SAPI-1 machine description, written by the SAPIemu configurator.
// Paths are relative to the emulator data folder (roms/, media/, work/).
{
    "name": "JPR-1S + BGP-1S + ANK-1M2 (Libor Lasota): MIKROBIOS 1.02, grafika PMD-85",
    "description": "Sestava Libora Lasoty pro hry převedené z PMD-85: procesorová deska JPR-1S rev 2.2 s MIKROBIOSem 1.02 a Falcon Monitorem 6.1L v EEPROM 28C64, RAM 2000h a tři banky 4000-FFFF, grafická karta BGP-1S rev 4.2 na C000h v režimu Colorace (videoram jen pro zápis, čte se banka RAM pod ní), klávesnice ANK-1M2 s joystickem (šipky + mezerník po Ctrl+F8, nebo gamepad) a redukce Redukce34KB01 se sériovou linkou na P1-IN7 pro příkaz BOOT (Intel HEX 19200 Bd, TCP 2325). Hry v media/jpr-1s: Soubor → Nahrát program (Intel HEX), např. manic_miner.hex nebo auto.hex (joystick vlevo/vpravo), pak JUMP 4400. docs/desky/JPR-1S.md, BGP-1S.md.",
    "main_display": "BGP-1S",               // Main output: the display window with the big place at the top left (else the console screen)
    "bus": {
        "type": "ARB-1"                     // ARB-1 (original, 8 positions)
    },
    "cards": [
        {
            "slot": 1,                      // position X1
            "type": "JPR-1S",               // CPU card 8080, JPR-1 remake with RAM banks (Libor Lasota)
            "rom": "roms/jpr-1s/MIKROBIOS_1.02.bin",  // EEPROM 28C64 (0000-1FFF) - MIKROBIOS 1.02 + Falcon 6.1L (04/2022, display BGP-1S)
            "keyboard": {                   // Keyboard (connector K2)
                "type": "ANK-1M2",
                "joyport": "joystick",      // Keyboard ANK-1M2: joystick connector (P1-IN D5-D0) - joystick (Atari)
                "software": "mikos"
            },
            "k3": "diag",                   // K3: what is plugged in - diagnostic board rev 2.0 (2x 7 segments, buttons + / -)
            "k2_adapter": "redukce34kb01",  // K2 adapter (cable of the keyboard) - Redukce34KB01 rev 2.0: RS-232 RX on P1-IN7 (INT, T keys not connected)
            "serial": {
                "tcp": { "bind": "127.0.0.1", "dcd_follows": false, "port": 2325, "protocol": "raw" }
            }
        },
        {
            "slot": 2,                      // position X2
            "type": "BGP-1S"                // Graphics 288x256 like PMD-85, TV (Libor Lasota)
        }
    ]
}
