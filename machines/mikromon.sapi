// Basic SAPI-1 setup for MikroMon 1.3 (matches Martin's real hardware).
// Paths are relative to the repository root (data root).
{
    "name": "MikroMon 1.3 (JPR-1ZI, DMR-1, AND-1Z-89, EKL-1)",
    "bus": {
        "type": "ARB-1C-8",     // ARB-1C with 8 positions (ZPC); ARB-1 = original, 8 positions
        "jp3": "2-3"            // slot 1 = CPU card, address buffers controlled by /AEN
    },
    "cards": [
        {
            "slot": 1,
            "type": "JPR-1ZI",
            "crystal_hz": 16000000,
            "cpu_mhz": 2,       // JP2/JP3 position 3 (2 MHz) or 4 (4 MHz)
            "bus_mhz": 2,       // JP2/JP3 position 2 (2 MHz) or 1 (4 MHz)
            "rom": "roms/mikromon/MikroMon1_3_f000.txt",
            "decoder": "2k",    // D3C: ROM at 0000-07FF while BOOT=1
            // EKL-1 | Consul 262.3 ("latch_mod": false = no 7474) | Consul 259.11 ("code": "koi8cs") | ANK-1
            // (docs/desky/klavesnice.md); can be changed at run time in Machine -> Keyboard
            "keyboard": { "type": "EKL-1" }
        },
        {
            "slot": 2,
            "type": "DMR-1",
            "ram_config": 1,    // JP3: RAM 0000-F7FF
            "uart_base": "10h", // JP2
            "baud": 9600,       // JP8
            "connected": true   // terminal on the line (DCD active); can be changed in the terminal window
            // TCP server for TeraTerm (see docs/seriova-linka.md); with dcd_follows MikroMon
            // uses the UART only when a client was connected before reset:
            // , "serial": { "tcp": { "port": 2323, "dcd_follows": false }, "pacing": true }
        },
        {
            "slot": 3,
            "type": "AND-1Z-89",
            "chargen": "roms/and-1z-89/AND-1Z_CharGen.bin",
            "map_enabled": false
        }
    ]
}
