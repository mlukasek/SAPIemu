// SAPI-1 machine description, written by the SAPIemu configurator.
// Paths are relative to the emulator data folder (roms/, media/, work/).
{
    "name": "CP/M 2.2 z RAM disku + MFC-1A (JPR-1ZI ECMON, DMR-1, AND-1Z-89, ZRMD-1, MFC-1A)",
    "description": "Sestava cpm_zrmd s řadičem MFC-1A (8272 + DMA 8257, Tesla Liberec 1989) a 8\" mechanikami. Při prvním zapnutí zvolit 2 = A: ZRMD-1, B,C: MFC8 (BIOS ECBIM8). Volba zůstane v RAM, další reset ji použije znovu. B: = mechanika A s disketou CP/M 2.2/P (data), C: = mechanika B. RAM disk má opravený BIOS ECBIM8 (doplněný RET v INIT_MFC, zdroják ..\\SAPI-karty\\ZRMD-1\\SRC), reset 8272 je podle schématu. Registr 0FH je zapojený podle překreslení EC1045 (D6 = 1 mechaniky zapnuté, jak čeká BIOS ECBIM8; originál Tesla je opačně, docs/desky/MFC-1A.md).",
    "bus": {
        "type": "ARB-1C-8",                 // ARB-1C 8 positions (ZPC)
        "jp3": "2-3"                        // JP3: 2-3 = CPU card in X1, 1-2 = address buffers off (PKT-1)
    },
    "cards": [
        {
            "slot": 1,                      // position X1
            "type": "JPR-1ZI",              // CPU card Z80 (new design)
            "rom": "roms/jpr-1zi/JPR-1ZI_ECMON_2k_Martin.bin",  // EPROM 2764 - ECMON 2k
            "decoder": "2k",                // PROM D3C: memory decoder - ROM 0000-07FF (2 KB)
            "cpu_mhz": 2,                   // JP2/JP3: CPU clock - 2 MHz (position 3)
            "bus_mhz": 2,                   // JP2/JP3: bus clock F2 - 2 MHz (position 2)
            "keyboard": { "type": "EKL-1" },  // Keyboard (connector X2)
            "printer": {                    // X3: printer (Centronics cable), LST: of the monitor
                "output": "work/printer/tiskarna.prn",
                "charset": "koi8cs",
                "busy_us": 100
            }
        },
        {
            "slot": 2,                      // position X2
            "type": "DMR-1",                // 128 KB RAM and serial port
            "battery": false,               // JP7: battery backup of the SRAM
            "ram_config": 1,                // JP3: RAM range - 1: 0000-F7FF (display at F800)
            "uart_base": "10h",             // JP2: UART ports
            "baud": 9600,                   // JP8: baud rate - 9600 Bd
            "connected": false,             // Terminal connected at start (DCD)
            "serial": {
                "pacing": true,             // PC side: no overrun (pacing)
                "tcp": {                    // PC side: TCP server
                    "port": 2323,           // TCP port
                    "bind": "127.0.0.1",    // Address (127.0.0.1 = this PC only)
                    "protocol": "telnet",   // Protocol
                    "dcd_follows": true     // DCD follows the client connection
                }
            }
        },
        {
            "slot": 3,                      // position X3
            "type": "AND-1Z-89",            // Alphanumeric display "Z" 1989
            "map_enabled": false            // S1: MAP1 disconnects the card
        },
        {
            "slot": 4,                      // position X4
            "type": "ZRMD-1",               // RAM disk 4 MB with RTC
            "image": "media/zrmd-1/SAPI_CPM_Martin_2019-10-07_fixMFC.bin",  // Disk image - CP/M (Martin 2019), BIOS ECBIM8 (MFC-1A) fixed
            "mode": "rw",                   // Mode - read/write, saved
            "write_enable": [
                true,                       // S1: write enable, 1st MB
                true,                       // S2: write enable, 2nd MB
                true,                       // S3: write enable, 3rd MB
                true                        // S4: write enable, 4th MB
            ],
            "rtc": true,                    // RTC 72421
            "rtc_int": "none",              // JP3: RTC interrupt
            "map_jp2": false                // JP2: port 63h b6/b7 drive MAP1/MAP2
        },
        {
            "slot": 5,                      // position X5
            "type": "MFC-1A",               // Mini floppy controller 8272 + DMA
            "drive_a": {                    // Drive A (8" SS SD)
                "image": "media/rpd-1/CPM22P_48A_Perina.img",  // Disk image (.img, 77 x 26 x 128 B) - CP/M 2.2/P 48K (Perina), as a data disk
                "write_protect": false      // Write protected
            },
            "working_copy": true,           // Work on copies in work/
            "decoder": "roms/mfc-1a/MFC-1A_DD9_74S287.bin",  // PROM DD9: port decoder - standard: 8257 04H, 05H, 08H, 8272 0CH-0DH, drive register 0FH
            "rdy_ground": false,            // X2-19 RDY grounded (8" Consul 7113 have no READY); else READY from the drive (disk in)
            "wiring": "ec1045",             // Wiring of the drive register 0FH - redraw EC1045 (replica): D5 reset, D4 INT, D6 = 1 drives on (BIOS ECBIM8)
            "reset_mode": "level"           // Register 0FH: the reset bit of the 8272 - 1 holds the reset (schematic; the unfixed ECBIM8 hangs at its initialization)
        }
    ]
}
