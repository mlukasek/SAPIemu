// SAPI-1 machine description, written by the SAPIemu configurator.
// Paths are relative to the emulator data folder (roms/, media/, work/).
{
    "name": "CP/M 2.2 Tesla Elstroj 1987 z kazetového disku RKD-1 (JPR-1Z, CM 5403)",
    "description": "Systém Tesla Elstroj & JaMeSoft 1987 pro kazetový disk CM 5403 (Zbrojovka Brno) s řadičem RKD-1: JPR-1Z s boot EPROM ROMES (přeložená ze zdrojáků 87-02-10, kód na 0000h), RAM-1Z 62 KB, AND-1Z, klávesnice Consul 259.11, RPD-1 (E:, F:, služební diskety J. Bíby) a RKD-1 (A:, B: kazeta, C:, D: pevný disk; 2x2x203x24x256). Systémová kazeta je vyrobená originálními programy FORMTRKD a ES (CBIOS 87-02-13), po startu se spustí shell SH se STARTSYS.SUB (číslo uživatele). Pevný disk je nový a nenaformátovaný: FORMTRKD, volba 2 (C:) a 3 (D:). docs/desky/RKD-1.md.",
    "bus": {
        "type": "ARB-1"                     // ARB-1 (original, 8 positions)
    },
    "cards": [
        {
            "slot": 1,                      // position X1
            "type": "JPR-1Z",               // CPU card Z80 (ZPS-4)
            "rom": "roms/jpr-1z/ROMES_RKD1_870210.bin",  // EPROM 2716 - Boot ROM RKD-1 (Tesla Elstroj 1987)
            "cpu_mhz": 2,                   // JP2/JP3: CPU clock - 2 MHz (position 3)
            "bus_mhz": 2,                   // JP2/JP3: bus clock F2 - 2 MHz (position 2)
            "keyboard": { "type": "Consul 259.11", "code": "koi8cs" }  // Keyboard (connector X2) - the CBIOS drives CONSUL 259.11 KOI8 CS2
        },
        {
            "slot": 2,                      // position X2
            "type": "RAM-1Z",               // Dynamic RAM up to 64 KB
            "fitted_kb": 64,                // Fitted memory - 64 KB (4 rows)
            "s1_1": false,                  // S1/1 closed (open = no F800-FFFF, 62 KB)
            "s1_2": true,                   // S1/2 closed (open = no F000-FFFF, 60 KB)
            "map": false                    // S1/4: MAP1 removes 0000-3FFF (else S1/3, ground)
        },
        {
            "slot": 3,                      // position X3
            "type": "AND-1Z"                // Alphanumeric display "Z"
        },
        {
            "slot": 4,                      // position X4
            "type": "RPD-1",                // Floppy disk controller (boards A + B)
            "drive_a": {                    // Drive 0 (8" SS SD)
                "cpm": "E",                 // CP/M letter (Media window)
                "image": "media/sapiman/knihovna/sysprog_a_sluzebni_CPM.img",  // J. Biba: service programs (PIP, STAT, FORMRKD...)
                "write_protect": false      // Write protected
            },
            "drive_b": {                    // Drive 1 (8" SS SD)
                "cpm": "F",                 // CP/M letter (Media window)
                "image": "media/sapiman/knihovna/sysprog_b_sluzebniCPM.img",  // J. Biba: service programs (DDT, LINK...)
                "write_protect": false      // Write protected
            },
            "working_copy": true            // Work on copies in work/
        },
        {
            "slot": 6,                      // position X6
            "type": "RKD-1",                // Cartridge disk controller CM 5403 (boards A + B)
            "unit0": {                      // Unit 0 (CM 5403: cartridge + fixed disk)
                "cartridge": "media/rkd-1/tesla_cpm_system.rkd",  // Cartridge image - CP/M 2.2 Tesla Elstroj 1987 (system cartridge, 24 x 256 B)
                "write_protect": false,     // Cartridge write protected
                "fixed": "work/rkd-1/unit0_fixed.rkd"  // Fixed disk image (.rkd, created when missing)
            },
            "working_copy": true            // Work on copies in work/
        }
    ]
}
