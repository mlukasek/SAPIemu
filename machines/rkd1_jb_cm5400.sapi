// SAPI-1 machine description, written by the SAPIemu configurator.
// Paths are relative to the emulator data folder (roms/, media/, work/).
{
    "name": "CP/M J. Bíby s kazetovým diskem RKD-1 a bulharskou mechanikou CM 5400 (FORMRKD, 12 × 512 B)",
    "description": "CP/M 2.2 J. Bíby z 8\" diskety A: (RPD-1, MON 271111), C: = RAM disk ZRMD-1, B: = služební disketa J. Bíby s programem FORMRKD v1.1 (20. 10. 1987, „Formátování a kontrola disku SM 5400 (203*12*512)“). RKD-1 s mechanikou CM 5400 (IZOT, Bulharsko) na kabelu SM 5400 podle dokumentace RKD-1: pevný disk D: (dolní plocha), E: (horní), výměnná kazeta F:, G:, formát SMEP 12 × 512 B. Kazeta i pevný disk jsou na začátku nenaformátované: B:FORMRKD, mechanika D až G (jen označení ve FORMRKD: v CP/M J. Bíby disky D: až G: nejsou, BIOS má jen A:, B:, C:), F = formátovat, C = kontrolní čtení, O = obojí. CP/M pro CM 5400 se nenašlo, CP/M Tesly je pro CM 5403 (ta je pro CM 5403, rkd1_tesla_cpm.sapi). docs/desky/RKD-1.md.",
    "bus": {
        "type": "ARB-1C-8",                 // ARB-1C 8 positions (ZPC)
        "jp3": "2-3"                        // JP3: 2-3 = CPU card in X1, 1-2 = address buffers off (PKT-1)
    },
    "cards": [
        {
            "slot": 1,                      // position X1
            "type": "JPR-1ZI",              // CPU card Z80 (new design)
            "rom": "roms/jpr-1zi/JPR-1ZI_MON271111_JB_RPD.bin",
            "decoder": "2k",                // PROM D3C: memory decoder - ROM 0000-07FF (2 KB)
            "cpu_mhz": 2,                   // JP2/JP3: CPU clock - 2 MHz (position 3)
            "bus_mhz": 2,                   // JP2/JP3: bus clock F2 - 2 MHz (position 2)
            "keyboard": { "type": "Consul 259.11", "code": "koi8cs" }  // Keyboard (connector X2) - the monitor drives CONSUL 259.11 KOI8 CS2
        },
        {
            "slot": 2,                      // position X2
            "type": "DMR-1",                // 128 KB RAM and serial port
            "ram_config": 1,                // JP3: RAM range - 1: 0000-F7FF (display at F800)
            "battery": false,               // JP7: battery backup of the SRAM
            "uart_base": "10h",             // JP2: UART ports
            "baud": 9600,                   // JP8: baud rate - 9600 Bd
            "connected": false              // Terminal connected at start (DCD): no, the console is the display
        },
        {
            "slot": 3,                      // position X3
            "type": "AND-1Z-89",            // Alphanumeric display "Z" 1989
            "map_enabled": false            // S1: MAP1 disconnects the card
        },
        {
            "slot": 4,                      // position X4
            "type": "ZRMD-1",               // RAM disk 4 MB with RTC
            "image": "media/zrmd-1/ZRMD-1_prazdny_OFF0.bin",  // Disk image - empty (C: of the CP/M of J. Biba)
            "mode": "rw",                   // Mode - read/write, saved
            "rtc": true,                    // RTC 72421
            "rtc_int": "none",              // JP3: RTC interrupt
            "map_jp2": false                // JP2: port 63h b6/b7 drive MAP1/MAP2
        },
        {
            "slot": 5,                      // position X5
            "type": "RPD-1",                // Floppy disk controller (boards A + B)
            "drive_a": {
                "cpm": "A",                 // CP/M letter (Media window)
                "image": "media/sapiman/r1_zrmd4m_271111.img",  // Boot disk (J. Biba)
                "write_protect": false
            },
            "drive_b": {
                "cpm": "B",                 // CP/M letter (Media window)
                "image": "media/sapiman/knihovna/sysprog_a_sluzebni_CPM.img",  // J. Biba: service programs (PIP, STAT, FORMRKD...)
                "write_protect": false
            },
            "working_copy": true,           // Work on copies in work/
            "step_ms": 8,                   // Drive: step period - 8 ms (Consul 7213)
            "settle_ms": 35                 // Drive: head load settle time (ms)
        },
        {
            "slot": 7,                      // position X7
            "type": "RKD-1",                // Cartridge disk controller CM 5403 / CM 5400 (boards A + B)
            "unit0": {                      // Unit 0 (cartridge + fixed disk)
                "drive": "CM 5400",         // Drive - CM 5400 (IZOT, Bulgaria; cable SM 5400, FORMRKD of J. Biba, 12 x 512 B)
                "cartridge": "work/rkd-1/cm5400_kazeta.rkd",  // Cartridge image (.rkd; a new file = an unformatted cartridge)
                "write_protect": false,     // Cartridge write protected
                "fixed": "work/rkd-1/cm5400_fixed.rkd"  // Fixed disk image (.rkd, created when missing)
            },
            "working_copy": true            // Work on copies in work/
        }
    ]
}
