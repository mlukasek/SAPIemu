// SAPI-1 machine description, written by the SAPIemu configurator.
// Paths are relative to the emulator data folder (roms/, media/, work/).
{
    "name": "ZPS-4 s FDC-1 (JPR-1Z, RAM-1Z, AND-1Z, DSM-1, FDC-1, RMD-1, Consul 262.3)",
    "description": "ZPS-4 jako ZPS-4.sapi, ale s řadičem FDC-1 (8272 + DMA, dva sloty) místo RPD-1: CP/M 2.2/P 62K od R. Peřiny pro FDC-1 (ROM MOR62ZF „SAPI-1 ZPS4-62K/FDC-1“, disketa CPM62ZF ze sapi.cz data2/cpm62zf_img.rar), RAM-1Z 62 KB, AND-1Z 64x20 na F800, DSM-1 na 10h, RAM disk RMD-1 256 KB na 40h (E:, inicializuje RTEST), klávesnice Consul 262.3. Pořadí karet ve slotech je odhad.",
    "bus": {
        "type": "ARB-1"                     // ARB-1 (original, 8 positions)
    },
    "cards": [
        {
            "slot": 1,                      // position X1
            "type": "JPR-1Z",               // CPU card Z80 (ZPS-4)
            "rom": "roms/jpr-1z/MOR62ZF.bin",  // EPROM 2716 - MOR62ZF: CP/M 2.2/P 62K for FDC-1 (Perina 1988)
            "cpu_mhz": 2,                   // JP2/JP3: CPU clock - 2 MHz (position 3)
            "bus_mhz": 2,                   // JP2/JP3: bus clock F2 - 2 MHz (position 2)
            "keyboard": { "type": "Consul 262.3", "latch_mod": true }  // Keyboard (connector X2)
        },
        {
            "slot": 2,                      // position X2
            "type": "RAM-1Z",               // Dynamic RAM up to 64 KB
            "fitted_kb": 64,                // Fitted memory - 64 KB (4 rows)
            "s1_1": false,                  // S1/1 closed (open = no F800-FFFF, 62 KB)
            "s1_2": true,                   // S1/2 closed (open = no F000-FFFF, 60 KB)
            "map": false                    // S1/4: MAP1 removes 0000-3FFF (else S1/3, ground)
        },
        {
            "slot": 3,                      // position X3
            "type": "AND-1Z"                // Alphanumeric display "Z"
        },
        {
            "slot": 4,                      // position X4
            "type": "DSM-1",                // Serial modem (cassette, terminal)
            "base": "10h",                  // Jumpers 16-12..16-15: ports
            "baud": 600,                    // Jumper: terminal baud rate - 600 Bd (factory)
            "int0": false,                  // UART interrupt on INT0
            "connected": false              // Terminal connected at start (DCD)
        },
        {
            "slot": 5,                      // position X5
            "type": "FDC-1",                // Floppy disk controller 8272 + DMA (boards A + B)
            "drive_a": {                    // Drive A (8" SS SD)
                "cpm": "A",                 // CP/M letter (Media window)
                "image": "media/fdc-1/CPM22P_62ZF_Perina.img",  // Disk image (.img, 77 x 26 x 128 B) - CP/M 2.2/P 62K for FDC-1 (Perina, AND-1Z)
                "write_protect": false      // Write protected
            },
            "working_copy": true,           // Work on copies in work/
            "decoder": "roms/fdc-1/FDC-1A_D5B_74S287.bin",  // PROM D5B (FDC-1A): port decoder - standard: 8257 04-0BH, 8272 0CH-0DH, FDC-1B 0EH-0FH
            "rdy_ground": true,             // FDC-1A X3-20 /RDY grounded (as supplied, Consul 7113): all drives ready
            "sa2_a": "8sd",                 // FDC-1B switches SA2 S1, S5: drive A - 8" SD (read by IN 0EH: D1 = 1, D0 = 0)
            "sa2_b": "8sd",                 // FDC-1B switches SA2 S2, S6: drive B - 8" SD (read by IN 0EH: D1 = 1, D0 = 0)
            "sa2_c": "8sd",                 // FDC-1B switches SA2 S3, S7: drive C - 8" SD (read by IN 0EH: D1 = 1, D0 = 0)
            "sa2_d": "8sd"                  // FDC-1B switches SA2 S4, S8: drive D - 8" SD (read by IN 0EH: D1 = 1, D0 = 0)
        },
        {
            "slot": 7,                      // position X7
            "type": "RMD-1",                // RAM disk
            "size_kb": 256,                 // Memory - 256 KB (32x 4164)
            "power_on": "random"            // Content after power on - random (like the DRAM, initialise it)
        }
    ]
}
