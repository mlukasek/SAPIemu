// SAPI-1 machine description, written by the SAPIemu configurator.
// Paths are relative to the emulator data folder (roms/, media/, work/).
{
    "name": "ZPS-4 ELIS (JPR-1Z, RAM-1Z, AND-1Z, DSM-1, RPD-1, RMD-1, Consul 262.3)",
    "description": "ZPS-4 se systémem ELIS 61k CP/M V2.2 (monitor ELIS v7.01 *JME/JPE v EPROM JPR-1Z, disketa ELIS ze sapi.cz): A, B = RPD-1 8\", C = RAM disk RMD-1 256 KB na 40h (po zapnutí náhodný obsah jako skutečná DRAM, inicializuje INIRMD5 volbou 2), AND-1Z 64x20 na F800 s češtinou, RAM-1Z 62 KB, DSM-1 na 10h bez terminálu, klávesnice Consul 262.3. ROM ELIS v3.00 je alternativa (roms/jpr-1z/ELIS_V3.00.bin). Pořadí karet ve slotech je odhad.",
    "bus": {
        "type": "ARB-1"                     // ARB-1 (original, 8 positions)
    },
    "cards": [
        {
            "slot": 1,                      // position X1
            "type": "JPR-1Z",               // CPU card Z80 (ZPS-4)
            "rom": "roms/jpr-1z/ELIS_V7.01.bin",  // EPROM 2716 - ELIS v7.01 (Z80, C259.11/C262.3)
            "cpu_mhz": 2,                   // JP2/JP3: CPU clock - 2 MHz (position 3)
            "bus_mhz": 2,                   // JP2/JP3: bus clock F2 - 2 MHz (position 2)
            "keyboard": { "type": "Consul 262.3", "latch_mod": true }  // Keyboard (connector X2)
        },
        {
            "slot": 2,                      // position X2
            "type": "RAM-1Z",               // Dynamic RAM up to 64 KB
            "fitted_kb": 64,                // Fitted memory - 64 KB (4 rows)
            "s1_1": false,                  // S1/1 closed (open = no F800-FFFF, 62 KB)
            "s1_2": true,                   // S1/2 closed (open = no F000-FFFF, 60 KB)
            "map": false                    // S1/4: MAP1 removes 0000-3FFF (else S1/3, ground)
        },
        {
            "slot": 3,                      // position X3
            "type": "AND-1Z"                // Alphanumeric display "Z"
        },
        {
            "slot": 4,                      // position X4
            "type": "DSM-1",                // Serial modem (cassette, terminal)
            "base": "10h",                  // Jumpers 16-12..16-15: ports
            "baud": 600,                    // Jumper: terminal baud rate - 600 Bd (factory)
            "int0": false,                  // UART interrupt on INT0
            "connected": false              // Terminal connected at start (DCD)
        },
        {
            "slot": 5,                      // position X5
            "type": "RPD-1",                // Floppy disk controller (boards A + B)
            "drive_a": {                    // Drive A (8" SS SD)
                "image": "media/rpd-1/ELIS_61K.img",  // Disk image (.img, 77 x 26 x 128 B)
                "write_protect": false      // Write protected
            },
            "working_copy": true,           // Work on copies in work/
            "step_ms": 8,                   // Drive: step period - 8 ms (Consul 7213)
            "settle_ms": 35                 // Drive: head load settle time (ms)
        },
        {
            "slot": 7,                      // position X7
            "type": "RMD-1",                // RAM disk
            "size_kb": 256,                 // Memory - 256 KB (32x 4164)
            "power_on": "random"            // Content after power on - random (like the DRAM, initialise it)
        }
    ]
}
