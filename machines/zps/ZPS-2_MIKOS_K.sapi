// SAPI-1 machine description, written by the SAPIemu configurator.
// Paths are relative to the emulator data folder (roms/, media/, work/).
{
    "name": "ZPS-2 MIKOS/K V5.0 s kazetovým záznamníkem dat KZD-1 (JPR-1, REM-1, RAM-1/48K, AND-1, DSM-1, DPP-1, DGD-1, Consul 262.3)",
    "description": "ZPS-2 s Monitorem V5.0E a MIKOSem/K V5.0 (TESLA ELTOS DIZ 1988, sapi.cz/sapi/doku2/v5.php) pro kazetopáskový záznamník dat KZD-1: monitor 0000-0BFF a MIKOS/K 0C00-17FF v EPROM 2708 na REM-1 (dump M5K-EPR1-3 z SAPI_DOKU/MIKOS5_K), KZD-1 na konektoru X2 desky DPP-1 (30h, port A řízení, port B stav, řídicí slovo 8Bh). Kazeta se vkládá v okně Média, poprvé ji připravte příkazem .K_I (inicializace pásky je u KZD-1 povinná). Příkazy MIKOSu/K: K_S uložit, K_L načíst, K_D adresář, K_Z na začátek záznamu (před načtením od začátku K_Z, ne K_R). Magnetofon na DSM-1 zůstává pro kopírovací program CKM. Jinak jako ZPS-2 s MIKOSem V5 (RAM-1/48K 4000-BFFF, DGD-1, AND-1, klávesnice Consul). docs/desky/KZD-1.md.",
    "bus": {
        "type": "ARB-1"                     // ARB-1 (original, 8 positions)
    },
    "cards": [
        {
            "slot": 1,                      // position X1
            "type": "JPR-1",                // CPU card 8080, memory mapped ports
            "rom": "",                      // EPROM sockets D4E-D7E (from 0000) - none (ZPS-1: EPROMs on REM-1)
            "eprom_type": "2708",           // Jumpers 7-8/4-5 or 9-7/4-6: EPROM type - 2708 (1 KB)
            "ram": false,                   // RAM 1 KB at 2000 (2x 2114)
            "int_key": false,               // Jumper 10-11: INT key -> interrupt R7
            "wait_state": false,            // Jumper 12-14: one wait state
            "crystal_hz": 18000000,         // Crystal (Hz, CPU = crystal / 9)
            "keyboard": { "type": "Consul 262.3", "latch_mod": true }  // Keyboard (connector X2)
        },
        {
            "slot": 2,                      // position X2
            "type": "REM-1",                // RAM and EPROM card
            "rom": "roms/mikos/MONITOR_V5.0E_MIKOS_K_V5.0.bin",  // EPROMs (from socket 1) - Monitor V5.0E + MIKOS/K V5.0 for the KZD-1 (6 KB)
            "eprom_type": "2708",           // Jumpers H/G/I/J: EPROM type - 2708 (1 KB)
            "eprom_block": 0,               // Jumper E: EPROM block - 0000-1FFF
            "eprom_block2": "none",         // Jumper F: second EPROM block (2716) - not connected
            "ram_block": "none",            // Jumper R: RAM block - not connected
            "ram_kb": 0                     // RAM fitted (KB, 2 per 4x 2114)
        },
        {
            "slot": 3,                      // position X3
            "type": "RAM-1",                // Dynamic RAM up to 48 KB
            "fitted_kb": 48,                // Fitted memory - RAM-1/48K
            "s1": false,                    // S1 (S1 S2: 10 = 4000-FFFF, 01 = 4000-BFFF, 11 = 4000-7FFF, 00 = 4000-DFFF)
            "s2": true                      // S2
        },
        {
            "slot": 4,                      // position X4
            "type": "AND-1",                // Alphanumeric display 40x24
            "charset": "MHB2501",           // Character generator - MHB 2501 latin (jumper 42-43)
            "rows": 24,                     // Rows - 24 rows (jumper 47-48)
            "int1": false,                  // Jumper 49-50: INT1 at the end of the frame
            "monitor": "amber"              // Monitor: phosphor colour (not on the card)
        },
        {
            "slot": 5,                      // position X5
            "type": "DSM-1",                // Serial modem (cassette, terminal)
            "base": "10h",                  // Jumpers 16-12..16-15: ports
            "baud": 600,                    // Jumper: terminal baud rate - 600 Bd (factory)
            "int0": false,                  // UART interrupt on INT0
            "tape": "",                     // Cassette in the recorder (WAV, MP3; a .hex program becomes a MIKOS tape)
            "tape_write_protect": true      // Cassette write protected
        },
        {
            "slot": 6,                      // position X6
            "type": "DPP-1",                // Parallel ports (2x 8255), PMD32-SD
            "base": "30h",                  // S1: ports - 30h-37h (1S1, 3S1 closed)
            "kzd1_channel": 1,              // KZD-1 on - channel 1 (base+0..3, X2), as MIKOS/K (30h)
            "kzd1": {                       // KZD-1 cassette data recorder (MIKOS/K)
                "cassette": "work/kzd-1/kazeta.kzd"  // Cassette (.kzd, created empty when missing)
            }
        },
        {
            "slot": 7,                      // position X7
            "type": "DGD-1",                // Graphic display 320x240
            "base": "C000",                 // Switch SP1-2: graphics RAM 16 KB from - C000H (switch SP1-2 open, ZPS-2, ZPS-3)
            "mapping": false,               // Switch SP1-1: with mapping (selected by MAP1)
            "wait_states": true             // Wait states (CPU waits for its window of the display)
        }
    ]
}
