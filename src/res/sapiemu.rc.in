// Windows resources of sapiemu.exe and sapiemu-cli.exe: the icon and the version (CMake fills in @...@)
#include <winver.h>

1 ICON "@SAPIEMU_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Martin Lukasek"
            VALUE "FileDescription", "SAPIemu - Tesla SAPI-1 emulator"
            VALUE "FileVersion", "@SAPIEMU_FULL_VERSION@"
            VALUE "InternalName", "SAPIemu"
            VALUE "LegalCopyright", "Copyright (C) 2026 Martin Lukasek, GNU GPL v3"
            VALUE "OriginalFilename", "@SAPIEMU_EXE@"
            VALUE "ProductName", "SAPIemu"
            VALUE "ProductVersion", "@SAPIEMU_FULL_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
