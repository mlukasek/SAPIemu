  E654    D6 03                 	SUB	3		;ODECTI ZA A: B: C:
  E656    57                    	ld	d,a		;D - fyz.disk
  E657    3A E9BF               	ld	a,(log_track)	;nastaveno pri SEEK
  E65A    5F                    	ld	e,a		;E - fyz.stopa 
