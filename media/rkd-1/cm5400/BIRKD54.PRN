  E65E    B7                    	or	a
  E65F    CB 3F                 	srl	a		;deleno 4 (4x128 byte)
  E661    CB 3F                 	srl	a		;fyz_sector = log_sektor/2 
  E663    4F                    	ld	c,a		;C - fyz.sektor
  E664    C9                    	ret
                                ;********************************
                                ;zapis bufferu na disketu
                                
  E665                          flush_buf::			;10 urovni SP
  E665    E5                    	push	hl
  E666    D5                    	push	de
  E667    C5                    	push	bc
  E668    3A E9C5               	ld	a,(buf_disk)	;fyz. disk (medium 0-3)
  E66B    57                    	ld	d,a
  E66C    3A E9C6               	ld	a,(buf_track)
  E66F    5F                    	ld	e,a
  E670    3A E9C7               	ld	a,(buf_sector)
