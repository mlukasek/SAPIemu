BIOS JPR1-Z 3 KB RKD-1 CM 5400 V091026 (SAPIemu)	MACRO-80 3.44	09-Dec-81	PAGE	1


                                TITLE	BIOS JPR1-Z 3 KB RKD-1 CM 5400 V091026 (SAPIemu)
                                ;
                                ; BIOS-3K for the CP/M of J. Biba with the cartridge disk RKD-1 and the Bulgarian drive CM 5400.
                                ; NOT AN ORIGINAL: made 2026-10-09 for the emulator SAPIemu (docs/desky/RKD-1.md), because no CP/M for
                                ; RKD-1 with the CM 5400 was found and FORMRKD of J. Biba could format disks no system could use.
                                ; Made from:
                                ;  - BIOS JPR1-Z 3 KB DLOUHY BIOS V260811JB, EDIT D: E: BLOK/DEBLOK 512/8 261211JB (bi2612E4 8x512.txt,
                                ;    SAPI_DOKU\SAPIMAN\CPM_SYSTEMY\ZMENA_CPM\FUNKCNI\JEN 8 PALCU\RPD A MFC\3K RPD MFC 8 512 261211): the frame,
                                ;    A: B: (RPD-1 through the monitor), the blocking/deblocking of 512 B sectors, boot and warm boot;
                                ;  - CBIOS JPR-1(Z) V271111_ZRMD_JB (bi271111EC_ZRMD4.txt): C: = ZRMD-1 4 MB, with the DPB of the boot disk
                                ;    r1_zrmd4m_271111 ("C: ZRMD1/4 MB + SYSTEM": OFF 32, DSM 1021), so C: keeps its files;
                                ;  - RKD.MAC 87-02-13 (Tesla ELSTROJ & JaMeSoft) as linked into FORMRKD.COM v1.1 of J. Biba: the header of a
                                ;    sector is only the track (track * 32, low byte first), so the disks formatted by FORMRKD read here.
                                ;    One fix of the original: RK_SEEK returned with BC left on the stack on an error.
                                ; D: E: = the fixed disk (lower, upper surface), F: G: = the cartridge (lower, upper), as FORMRKD names them.
                                ; 204 tracks x 12 sectors x 512 B, 2 KB blocks, 256 directory entries, 1224 KB per surface.
                                ;
                                ;************************
                                .Z80
  000D                          VERZE	EQU	13
                                ;
  F800                          MEMORY	EQU	0F800H		;VELIKOST PAMETI 62 KB
  0C00                          CBIOSL	EQU	0C00H		;DELKA CBIOS NA DISKETE (MAX 13 SEKTORU)
                                				;+ DIRBUF+ALL+CHK JE MAX 15 SEKTORU
                                				;DALSICH 6 SEKTORU NA STOPE 76
                                				;A: B: 8" SS SD RPD-1
                                				;C: ZRMD-1/4MB + SYSTEM
                                				;D: E: F: G: RKD-1 CM 5400 12x512
  0800                          MONITL	EQU	0800H		;DELKA MONITORU (ROM) VCETNE TABULEK
  1400                          BIOSL	EQU	CBIOSL+MONITL	;CELKOVA DELKA BIOS 
  0800                          CCPL	EQU	0800H		;DELKA CCP (KONST.)
  0E00                          BDOSL	EQU	0E00H		;DELKA BDOS (KONST)
  2A00                          OVERL	EQU	CCPL+BDOSL+BIOSL	;DELKA SYSTEMU CELKEM
                                	;
  CE00                          CCPB	EQU	MEMORY-OVERL		;CCP BASE
  D606                          BDOSB	EQU	CCPB+CCPL+6		;BDOS BASE
  E400                          CBIOSB	EQU	CCPB+CCPL+BDOSL		;BIOS BASE
  F000                          MONITB	EQU	CCPB+CCPL+BDOSL+CBIOSL	;MONITOR (ROM) BASE
  E400                          BIOSB	EQU	CBIOSB			;BIOS BASE=CBIOS BASE
  F800                          STACK	EQU	MEMORY
  0004                          DRVINP	EQU	4
                                
                                
  F004                          VCOMP	EQU	MONITB+4H
  F006                          MCONST	EQU	MONITB+06H	;CONST UTILITY MONITORU
  F009                          MCONIN	EQU	MONITB+09H	;CONIN UTILITY MONITORU
  F00C                          MCONOU	EQU	MONITB+0CH	;CONOUT UTILITY MONITORU
  F00F                          MLSTST	EQU	MONITB+0FH	;LSTST UTILITY MONITORU
  F012                          MLSTOU	EQU	MONITB+12H	;LSTOUT UTILITY MONITORU
  F015                          MPUNCH	EQU	MONITB+15H	;PUNCH UTILITY MONITORU
  F018                          MREADR	EQU	MONITB+18H	;READER UTILITY MONITORU
  F01B                          MSELE	EQU	MONITB+1BH	;SELECT UTILITY MONITORU
  F01E                          MHOME	EQU	MONITB+1EH	;HOME UTILITY MONITORU
  F021                          MSEEK	EQU	MONITB+21H	;SEEK UTILITY MONITORU
  F024                          MREAD	EQU	MONITB+24H	;READ UTILITY MONITORU
  F027                          MWRITE	EQU	MONITB+27H	;WRITE UTILITY MONITORU
BIOS JPR1-Z 3 KB RKD-1 CM 5400 V091026 (SAPIemu)	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                                
                                ;************************
  0000'                         PATRN::
                                	PUBLIC	BIOS
                                
                                	.PHASE	CBIOSB
                                ;************************
                                
  E400                          BIOS::
  E400    C3 E970               	JP BOOT
  E403    C3 E8C4               	JP WBOOT
  E406    C3 F006               	JP MCONST
  E409    C3 F009               	JP MCONIN
  E40C    C3 F00C               	JP MCONOU
  E40F    C3 F012               	JP MLSTOU
  E412    C3 F015               	JP MPUNCH
  E415    C3 F018               	JP MREADR
  E418    C3 E50D               	JP HOME
  E41B    C3 E4F9               	JP SELECT
  E41E    C3 E510               	JP SEEK
  E421    C3 E515               	JP SETSEC
  E424    C3 E51A               	JP SETPTR
  E427    C3 E51F               	JP READ
  E42A    C3 E568               	JP WRITE
  E42D    C3 F00F               	JP MLSTST
  E430    C3 E595               	JP TRANS
                                ;----------------------------
  E433                          DP_BASE::
  E433    E4A3 0000             	DW SKEW81, 0,0,0,DIRBUF,DPB_81, CHK_A,ALL_A
  E437    0000 0000             
  E43B    EC5F E4BD             
  E43F    E9CB EA6B             
  E443    E4A3 0000             	DW SKEW81, 0,0,0,DIRBUF,DPB_81, CHK_B,ALL_B
  E447    0000 0000             
  E44B    EC5F E4BD             
  E44F    E9DB EA8B             
  E453    0000 0000             	DW 0,0,0,0,      DIRBUF,DPB_ZR,CHK_C,ALL_C
  E457    0000 0000             
  E45B    EC5F E4EA             
  E45F    E9EB EAAB             
  E463    0000 0000             	DW 0,0,0,0,      DIRBUF,DPB_RF,CHK_D,ALL_D	;RKD pevny dolni
  E467    0000 0000             
  E46B    EC5F E4CC             
  E46F    E9EB EB2B             
  E473    0000 0000             	DW 0,0,0,0,      DIRBUF,DPB_RF,CHK_E,ALL_E	;RKD pevny horni
  E477    0000 0000             
  E47B    EC5F E4CC             
  E47F    E9EB EB78             
  E483    0000 0000             	DW 0,0,0,0,      DIRBUF,DPB_RV,CHK_F,ALL_F	;RKD vymenny dolni
  E487    0000 0000             
  E48B    EC5F E4DB             
  E48F    E9EB EBC5             
  E493    0000 0000             	DW 0,0,0,0,      DIRBUF,DPB_RV,CHK_G,ALL_G	;RKD vymenny horni
  E497    0000 0000             
  E49B    EC5F E4DB             
  E49F    EA2B EC12             
BIOS JPR1-Z 3 KB RKD-1 CM 5400 V091026 (SAPIemu)	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                                ;----------------------------
  E4A3                          SKEW81::
  E4A3    01 07 0D 13           	db	1,7,13,19,25
  E4A7    19                    
  E4A8    05 0B 11 17           	db	5,11,17,23
  E4AC    03 09 0F 15           	db	3,9,15,21
  E4B0    02 08 0E 14           	db	2,8,14,20,26
  E4B4    1A                    
  E4B5    06 0C 12 18           	db	6,12,18,24
  E4B9    04 0A 10 16           	db	4,10,16,22
                                
                                ;CISLOVANO OD 0!! KVULI BLOK/DEBLOK
                                ;----------------------------
                                ;8" SS SD 26x128x77, AB=1k, 64 polozek adresare
  E4BD                          DPB_81::
  E4BD    001A                  	DW	26	;SEKTORU / STOPU
  E4BF    03                    	DB	3	;BLOCK SHIFT
  E4C0    07                    	DB	7	;BLOCK MASK
  E4C1    00                    	DB	0	;EXTENT MASK
  E4C2    00F2                  	DW	242	;CISLO MAX. ALOK. SKUPINY -1
  E4C4    003F                  	DW	63	;POLOZEK V ADRESarI -1
  E4C6    C0                    	DB	11000000B ;BIT MAPA ALOK. SKUP. PRO ADRESAR
  E4C7    00                    	DB	00000000B
  E4C8    0010                  	DW	16	;BYTU PRO KONTROLU ADRESARE
  E4CA    0002                  	DW	2	;SYSTEMOVE STOPY
                                	
                                ;----------------------------
                                ;8" SS SD fyz 8x512x77, log 32x128x77, AB=2k, 64 polozek adresare
                                ;RKD-1 CM 5400 pevny disk: fyz 12x512x204, log 48x128x204, AB=2k, 256 polozek adresare
  E4CC                          DPB_RF::
  E4CC    0030                  	DW	48	;SEKTORU / STOPU
  E4CE    04                    	DB	4	;BLOCK SHIFT
  E4CF    0F                    	DB	15	;BLOCK MASK
  E4D0    00                    	DB	0	;EXTENT MASK
  E4D1    0263                  	DW	611	;CISLO MAX. ALOK. SKUPINY -1
  E4D3    00FF                  	DW	255	;POLOZEK V ADRESARI -1
  E4D5    F0                    	DB	11110000B ;BIT MAPA ALOK. SKUP. PRO ADRESAR
  E4D6    00                    	DB	00000000B
  E4D7    0000                  	DW	0	;PEVNY DISK, BEZ KONTROLY ADRESARE
  E4D9    0000                  	DW	0	;SYSTEMOVE STOPY NEJSOU
                                ;----------------------------
                                ;RKD-1 CM 5400 kazeta (vymenna): jako pevny, s kontrolou adresare
  E4DB                          DPB_RV::
  E4DB    0030                  	DW	48	;SEKTORU / STOPU
  E4DD    04                    	DB	4	;BLOCK SHIFT
  E4DE    0F                    	DB	15	;BLOCK MASK
  E4DF    00                    	DB	0	;EXTENT MASK
  E4E0    0263                  	DW	611	;CISLO MAX. ALOK. SKUPINY -1
  E4E2    00FF                  	DW	255	;POLOZEK V ADRESARI -1
  E4E4    F0                    	DB	11110000B ;BIT MAPA ALOK. SKUP. PRO ADRESAR
  E4E5    00                    	DB	00000000B
  E4E6    0040                  	DW	64	;BYTU PRO KONTROLU ADRESARE
  E4E8    0000                  	DW	0	;SYSTEMOVE STOPY NEJSOU
                                ;----------------------------
                                ; ZRMD-1 RAMDISK 4Mb, 4 kB bloky, 1024 polozek adresare, 32 stop (8 kB) systemu
                                ; (jako bootovaci disketa r1_zrmd4m_271111 "C: ZRMD1/4 MB + SYSTEM")
BIOS JPR1-Z 3 KB RKD-1 CM 5400 V091026 (SAPIemu)	MACRO-80 3.44	09-Dec-81	PAGE	1-3


  E4EA                          DPB_ZR::
  E4EA    0002                  	DW	2	;SPT
  E4EC    05                    	DB	5	;BSH
  E4ED    1F                    	DB	31	;BLM
  E4EE    01                    	DB	1	;EXM
  E4EF    03FD                  	DW	1021	;DSM
  E4F1    03FF                  	DW	1023	;DRM
  E4F3    FF                    	DB	0FFH	;AL0
  E4F4    00                    	DB	0	;AL1
  E4F5    0000                  	DW	0	;CKS
  E4F7    0020                  	DW	32	;OFF
                                ;*****************************************
                                ;	DISKOVE FUNKCE
                                ;*****************************************
                                ; Vyber aktualniho disku.
                                ; I: cislo disku 0 az n
                                ; O: HL=adresa tabulky DPH, pokud je OK
                                ;    HL=0, pri chybe
                                
  E4F9                          SELECT::
  E4F9    21 0000               	LD	HL,0
  E4FC    79                    	LD	A,C
  E4FD    FE 07                 	CP	7		;A: az G:
  E4FF    D0                    	RET	NC
  E500    32 E9BE               	LD	(LOG_DISK),A	;ULOZ CISLO DISKU
  E503    6F                    	LD	L,A
                                	REPT	4
                                	ADD	HL,HL
                                	ENDM
  E504    29              +     	ADD	HL,HL
  E505    29              +     	ADD	HL,HL
  E506    29              +     	ADD	HL,HL
  E507    29              +     	ADD	HL,HL
  E508    11 E433               	LD	DE,DP_BASE
  E50B    19                    	ADD	HL,DE
  E50C    C9                    	RET
                                ;----------------------------
                                ; Nastaveni vybrane mechaniky na hlavu 0.
                                
  E50D                          HOME::
  E50D    01 0000               	LD	BC,0
                                ;----------------------------
                                ; Nastaveni hlavy vybrane mechaniky na vybranou stopu (cylindr).
                                ; I: BC=cislo cylindra
                                
  E510                          SEEK::
  E510    ED 43 E9BF            	LD	(LOG_TRACK),BC
  E514    C9                    	RET
                                ;----------------------------
                                ; Nastaveni cisla pozadovaneho sektoru.
                                ; I: C=cislo sektoru
                                
  E515                          SETSEC::
  E515    79                    	LD	A,C
  E516    32 E9C1               	LD	(LOG_SECTOR),A
  E519    C9                    	RET
BIOS JPR1-Z 3 KB RKD-1 CM 5400 V091026 (SAPIemu)	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                ;----------------------------
                                ; Nastaveni DMA adresy
                                ; I: BC=DMA adresa
                                ; O: -
                                ; M: HL
                                
  E51A                          SETPTR::
  E51A    ED 43 E9C2            	LD	(DMA_ADR),BC	
  E51E    C9                    	RET
                                ;----------------------------
                                ; Precteni pozadovaneho sektoru
                                ; I: dopredu nastaveny sektor, stopa a DMA
                                ; O: A=0 a Z - OK
                                ;    A=1 a NZ - chyba
                                ; M: vsechny
                                
  E51F                          READ::
  E51F    3A E9BE               	LD	A,(LOG_DISK)
  E522    FE 02                 	CP	2
  E524    28 1B                 	JR	Z,RDRMD		;C: ZRMD
  E526    D2 E5B9               	JP	NC,READ_RKD	;D: az G:
  E529    CD E5A0               	CALL	WICH_DISK	;A: B:
  E52C    CD F024               	CALL	MREAD		;cteni v monitoru
  E52F    C8                    	RET	Z		;pokud neni chyba
  E530    21 E58A               	LD	HL,RWERR
  E533    CD E95F               	CALL	PMSG		;vypis chyby
  E536    CD F009               	CALL	MCONIN		;znak z klav.
  E539    FE 1B                 	CP	1BH
  E53B    20 E2                 	JR	NZ,READ		;pokud neni ESC
  E53D    3E 01                 	LD	A,1		;navrat s chybou
  E53F    B7                    	OR	A
  E540    C9                    	RET
                                ;----------------------------
                                ;----------------------------
                                ; ZRMD-1 (z BIOS-1K V271111_ZRMD_JB)
  0060                          Z_R_W	EQU	60H		;BASE ZRMD1
  E541                          RDRMD::
  E541    CD E54F               	CALL	RMD.1
  E544    ED B2                 	INIR
  E546    AF                    	XOR	A
  E547    C9                    	RET
  E548                          WRRMD::
  E548    CD E54F               	CALL	RMD.1
  E54B    ED B3                 	OTIR
  E54D    AF                    	XOR	A
  E54E    C9                    	RET
  E54F                          RMD.1::
  E54F    0E 61                 	LD	C,Z_R_W+1	; bazova adresa
  E551    3A E9C1               	LD	A,(LOG_SECTOR)	; sektor 0 nebo 1
  E554    0F                    	RRCA			; sektor do do B7
  E555    ED 79                 	OUT	(C),A		; nastaveni citacu A0-A7
  E557    2A E9BF               	LD	HL,(LOG_TRACK)	; cislo stopy do HL
  E55A    0C                    	INC	C		; port pro A8 - A15
  E55B    ED 69                 	OUT	(C),L		; zapis nizsiho byte stopy
  E55D    0C                    	INC	C		; port pro A16 - A19
  E55E    ED 61                 	OUT	(C),H		; zapis vyssiho byte stopy
BIOS JPR1-Z 3 KB RKD-1 CM 5400 V091026 (SAPIemu)	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  E560    2A E9C2               	LD	HL,(DMA_ADR)	; zdrojova/cilova adresa do HL
  E563    0E 60                 	LD	C,Z_R_W		; C=datovy port R/W
  E565    06 80                 	LD	B,80H		; B=128 bytu
  E567    C9                    	RET
                                ;----------------------------
                                ; Zapis pozadovaneho sektoru
                                ; I: dopredu nastaveny sektor, stopa a DMA
                                ; O: A=0 a Z - OK
                                ;    A=1 a NZ - chyba
                                ; M: vsechny
                                
  E568                          WRITE::
  E568    3A E9BE               	LD	A,(LOG_DISK)
  E56B    FE 02                 	CP	2
  E56D    28 D9                 	JR	Z,WRRMD		;C: ZRMD
  E56F    D2 E5ED               	JP	NC,WRITE_RKD	;D: az G:
  E572    CD E5A0               	CALL	WICH_DISK	;A: B:
  E575    CD F027               	CALL	MWRITE		;zapis v monitoru
  E578    C8                    	RET	Z		;pokud neni chyba
  E579    21 E58A               	LD	HL,RWERR
  E57C    CD E95F               	CALL	PMSG		;vypis chyby
  E57F    CD F009               	CALL	MCONIN		;znak z klav.
  E582    FE 1B                 	CP	1BH
  E584    20 E2                 	JR	NZ,WRITE	;pokud neni ESC
  E586    3E 01                 	LD	A,1		;navrat s chybou
  E588    B7                    	OR	A
  E589    C9                    	RET
                                ;----------------------------
  E58A                          RWERR::
  E58A    0D 0A 52 2F           	DB	0DH,0AH,'R/W err!',0
  E58E    57 20 65 72           
  E592    72 21 00              
                                ;----------------------------
                                ; Prepocet logickych cisel sektoru na fyzicke
                                ; I: DE=adresa prekladove tabulky
                                ;    BC=logicke cislo sektoru 0 az n
                                ; O: HL=fyzicke cislo sektoru
                                ; M: HL, DE, BC, PSW
                                
  E595    69                    TRANS::	LD	L,C		; cislo sektora do HL
  E596    60                    	LD	H,B
  E597    7B                    	LD	A,E		; platna adresa prekladove tabulky ?
  E598    B2                    	OR	D
  E599    C8                    	RET	Z		; ne vrat se s puvodni hodnotou cisla sektoru
  E59A    EB                    	EX	DE,HL
  E59B    09                    	ADD	HL,BC
  E59C    6E                    	LD	L,(HL)
  E59D    26 00                 	LD	H,0
  E59F    C9                    	RET
                                ;----------------------------
                                ; Procedury pred vlastnim ctenim/zapisem RPD-1
                                ; Provede se Selekt, nastavi Stopa, nacte Sektor a DMA adresa
                                ; O: HL= DMA adresa
                                ;    A,C=logicke cislo sektoru 0 az n
                                ; M: HL, C, PSW
                                
BIOS JPR1-Z 3 KB RKD-1 CM 5400 V091026 (SAPIemu)	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  E5A0                          WICH_DISK::
  E5A0    3A E9BE               	LD	A,(LOG_DISK)
  E5A3    4F                    	LD	C,A
  E5A4    CD F01B               	CALL	MSELE		;vyber disk na RPD
  E5A7    3A E9BF               	LD	A,(LOG_TRACK)
  E5AA    4F                    	LD	C,A
  E5AB    CD F021               	CALL	MSEEK		;vyber stopu na RPD
  E5AE    2A E9C2               	LD	HL,(DMA_ADR)	;kam cist/psat do HL
  E5B1    3E 01                 	LD	A,1
  E5B3    B7                    	OR	A
  E5B4    3A E9C1               	LD	A,(LOG_SECTOR)	;sektor do A, C
  E5B7    4F                    	LD	C,A
  E5B8    C9                    	RET
                                ;*******************************
                                SUBTTL BLOK/DEBLOK 512 B PRO RKD-1 (z V261211JB)
                                ;*******************************
                                ;********************************
  E5B9                          READ_RKD::
                                ; BDOS ma prilis maly zasobnik
                                ;
  E5B9    21 0000               	ld	hl,0	
  E5BC    39                    	add	hl,sp
  E5BD    22 E9BC               	ld	(sp_save),hl
  E5C0    31 E9BC               	ld	sp,bios_stack
  E5C3    CD E5CB               	call	rd512		;12 urovni SP=24 byte
  E5C6    2A E9BC               	ld	hl,(sp_save)
  E5C9    F9                    	ld	sp,hl
  E5CA    C9                    	ret
                                ;--------------------------------
                                
  E5CB                          rd512::
  E5CB    CD E651               	call	set_reg		;nastavi log. do registru
  E5CE    CD E681               	call	fill_buf	;11 nacti sektor do bufferu
                                				;cteni OK A=0, Z
  E5D1    C0                    	ret	nz		;navrat pri chybe A=FF, NZ
                                ;--------------------------------
  E5D2    21 EC5F               	ld	hl,buf_8-128	;pocatek bufferu fyz.sektoru
  E5D5    11 0080               	ld	de,128		;delka log.sektoru
  E5D8    3A E9C1               	ld	a,(log_sector)
  E5DB    E6 03                 	and	3		;jen spodni 2 byty (4 sektory)
                                ;--------------------------------
  E5DD    47                    	ld	b,a
  E5DE    04                    	inc	b
  E5DF    19                    rd1::	add	hl,de
  E5E0    10 FD                 	djnz	rd1
                                				;HL=buf_8 + x
  E5E2    ED 5B E9C2            	ld	de,(dma_adr)	;kam ulozit dle CP/M
  E5E6    01 0080               	ld	bc,128		;delka log.sektoru
  E5E9    ED B0                 	ldir			;prepis z buf_8 do DMA
  E5EB    AF                    	xor	a		;cteni OK A=0,Z	
  E5EC    C9                    	ret
                                ;********************************
  E5ED                          WRITE_RKD::
                                ; BDOS ma prilis maly zasobnik
                                ;
  E5ED    21 0000               	ld	hl,0	
BIOS JPR1-Z 3 KB RKD-1 CM 5400 V091026 (SAPIemu)	MACRO-80 3.44	09-Dec-81	PAGE	1-7
BLOK/DEBLOK 512 B PRO RKD-1 (z V261211JB)

  E5F0    39                    	add	hl,sp
  E5F1    22 E9BC               	ld	(sp_save),hl
  E5F4    31 E9BC               	ld	sp,bios_stack
  E5F7    CD E5FF               	call	wr512		;12 urovni SP=24 byte
  E5FA    2A E9BC               	ld	hl,(sp_save)
  E5FD    F9                    	ld	sp,hl
  E5FE    C9                    	ret
                                ;********************************
  E5FF                          wr512::
  E5FF    79                    	ld	a,c
  E600    32 E9C4               	ld	(wr_type),a	;uloz typ zapisu
                                				;0=normalni zapis do jiz al.bloku
                                				;1=adresar 
  E603    CD E651               	call	set_reg		;nastavi log. do registru
                                ;--------------------------------
