                                				;zapis OK A=0,Z
                                				;chyba A=1, NZ
  E677    F5                    	push	af
  E678    AF                    	xor	a
  E679    32 E9C8               	ld	(buf_write),a	;priznak buffer je prazdny
  E67C    F1                    	pop	af
  E67D    C1                    	pop	bc
  E67E    D1                    	pop	de
  E67F    E1                    	pop	hl
  E680    C9                    	ret
                                
