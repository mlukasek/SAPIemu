                                ;	  1 =>	      1
                                ; bit 12..5: CIslo stopy: 0..203
                                ; bit 4..0: CIslo sektoru: 0..11 nebo 0..23
                                ;			    512	       256
                                
  E885                          PREP_MARK:
                                ; SAPIemu: jako ovladac ve FORMRKD.COM (J. Biba): zahlavi je jen stopa * 32,
                                ; bez sektoru, media a priznaku 512 B (RKD.MAC 87-02-13 je pridava)
  E885    C5                    	PUSH	BC
  E886    06 03                 	LD	B,3
  E888    4B                    	LD	C,E
  E889    1E 00                 	LD	E,0
  E88B    B7                    	OR	A
  E88C                          .1.PREP_MARK:
  E88C    CB 1A                 	RR	D
  E88E    CB 1B                 	RR	E
  E890    10 FA                 	DJNZ	.1.PREP_MARK
  E892    C1                    	POP	BC
  E893    C9                    	RET
                                
