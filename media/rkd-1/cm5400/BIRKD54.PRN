  E884    C9                    	RET				;hotovo
                                
                                ;************************************************************
                                ;funkce	PREP_MARK
                                ;vstup	<d> - CIslo stopy
                                ;	<e> - CIslo sektoru
                                ;	<bc> - dWlka sektoru v bytech
                                ;vYstup	<de> - zAhlavI sektoru
                                ;popis	PREP_MARK transformuje stopu, sektor, dWlku sektoru
                                ;	a CIslo mWdia do 16-ti bitovWho zAhlavI:
                                ;
                                ; bit 15: 0 => sektor 256 byte
