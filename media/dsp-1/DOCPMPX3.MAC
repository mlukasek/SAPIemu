;
; DOCPM - Tento CP/M program prijima soubor z PC zaslany prostrednictvim seriove
; linky a zapise ho do souboru CP/M systemu. Program na PC musi poslat soubor
; v formatu XMODEM/protokol. Napriklad Hyperterminal
; Spusteni DOCPM xxxxxxxx.xxx
; Prenasi vsechny typy souboru
;
;****************************************
CNT_X2	EQU	49H		;PORTY DSP 1/X2 + X3
DAT_X2	EQU	48H
CNT_X3	EQU	4BH
DAT_X3	EQU	4AH
P_INT	EQU	4CH
;----------------------------------------
ERROR_LIMIT	EQU	9	;MAXIMUM CHYB
;----------------------------------------
;DEFINE ASCII CHARACTERS
SOH	EQU	1
EOT	EQU	4
ACK	EQU	6
NAK	EQU	15H
LF	EQU	10
CR	EQU	13
CEOL	EQU	1EH
;-----------------------------------
;
; BDOS KONSTANTY (VER 2.2)
;
RDCON	EQU	1
WRCON	EQU	2
PRINT	EQU	9
CONST	EQU	11	;CONSOLE STAT
OPEN	EQU	15	;0FFH=NOT FOUND
CLOSE	EQU	16	;   "	"
SRCHF	EQU	17	;   "	"
SRCHN	EQU	18	;   "	"
ERASE	EQU	19	;NO RET CODE
READ	EQU	20	;0=OK, 1=EOF
WRITE	EQU	21	;0=OK, 1=ERR, 2=?, 0FFH=NO DIR SPC
MAKE	EQU	22	;0FFH=BAD
REN	EQU	23	;0FFH=BAD
STDMA	EQU	26
BDOS	EQU	5
REIPL	EQU	0
FCB	EQU	5CH	;SYSTEM FCB
;****************************************

	ASEG
	ORG	100H

	JMP	START		;GO, PRINT ID

MSG_ID::
	DB	'*** PRIJEM SOUBORU Z PC ***',CR,LF
	DB	'  pres DSP-1/X3 baze 4AH',CR,LF
	DB	'      C 25012013 JB',CR,LF,LF,'$'

START::
	LXI	D,MSG_ID	;VEM ID MESSAGE
	CALL	PRINT_MESSAGE

;INIC LOKALNIHO STACKU
	LXI	H,0		;HL=0
	DAD	SP		;HL=STACK CP/M
	SHLD	STACK		;ULOZ HO
	LXI	SP,STACK	;SP=MUJ STACK
	CALL	INIT_DSM1	;INIC MODEMU

;"VYCISTI" PRIJMOVE REGISTRY 				
	MVI	B,1		;ZPOZDENI 1 SEK
	CALL	RECV
	MVI	B,1
	CALL	RECV
	JMP	RECV_FILE	;VLASTNI PRIJEM SOUBORU

;********************************
;INICIALIZACE SERIOVEHO PORTU

INIT_DSM1::
	LXI	D,MSG_INIT
	CALL	PRINT_MESSAGE	;"9600....
;INIT DSP-1
;nastaveni blokovani preruseni, formovani,
;vnitrni reset, druh provozu, 1.comand 
	
	XRA	A
	OUT	P_INT
	OUT	CNT_X3
	OUT	CNT_X3
	OUT	CNT_X3
	MVI	A,40H		;reset UART
	OUT	CNT_X3
	MVI	A,01001110B	;SB1,P0,B8,x16
	OUT	CNT_X3
	MVI	A,00010101B	;RTS=0,ER=1,DTR=0,RXE,TXEN=1
	OUT	CNT_X3		;signaly na konektoru!!!
	RET

MSG_INIT::
	DB '9600 Bd, 8 bit, 2 stop, parita 0, rizeni RTS',CR,LF,'$'

;******************************************
; PRIJEM SOUBORU
;------------------------------------------
RECV_FILE::
	CALL	ERASE_OLD_FILE	;VYMAZ SOUBOR DLE FCB	
	CALL	MAKE_NEW_FILE	;ZALOZ SOUBOR DLE FCB
RECV_LOOP::
	XRA	A
	STA	ERRCT		;VYNULUJ POCITADLO CHYB
RECV_HDR::
	LXI	D,RMSG
	CALL	PRINT_MESSAGE	;"CELAM PAKET.."
	LDA	SECTNO		;NACTI CISLO PAKETU
	INR	A		;ZVYS PRO TISK
	CALL	HEXO		;VYTISKMI
	CALL	CR_PR		;PRO ODRADKOVANI
	MVI	B,3		;3 SEC TIMEOUT
	CALL	RECV		;CTI ZAHLAVI 1. ZNAK
	JNC	RHNTO		;OK, NENI TIMEOUT

RECV_HDR_TIMEOUT::
	CALL	TOUT		;TISK TIMEOUT

RECV_SECT_ERR::
	MVI	B,1		
	CALL	RECV		;"VYCISTENI" LINKY
	JNC	RECV_SECT_ERR 	;LOOP UNTIL SENDER DONE
	MVI	A,NAK
	CALL	SEND		;NEUSPECH ODESLI NAK PRO OPAK.
	LDA	ERRCT
	INR	A
	STA	ERRCT		;PRICTI POCET CHYB
	CPI	ERROR_LIMIT	;KONTROLA LIMIT CHYB
	JC	RECV_HDR	;NENI LIMIT, ZNOVA HDR
	CALL	CHECK_FOR_QUIT	;MNOHO CHYB, CO DELAT?
	JZ	RECV_HDR	;ZKUS ZNOVA CIST HDR
	CALL	ERXIT		;PO LIMITU CHYB UKONCI

	DB	'** Nelze ziskat platne zahlavi',CR,LF,'$'

RMSG::
	DB	'  Cekam paket #$'

;--------------------------------
;PRVNI PRIJATY ZNAK V HDR - MUSI BYT SOH

RHNTO::
	CPI	SOH		;POCATEK HDR
	JZ	GOT_SOH		;POKUD JE SOH
	ORA	A		;CHYBA RYCHLOSTI?
	JZ	RECV_HDR	;ZKUS ZNOVA CEKAT HDR
	CPI	EOT
	JZ	GOT_EOT		;PRISEL EOT, KONEC SOUBORU

;NEPRISEL SOH ANI EOT  
	CALL	HEXO		;VYPIS CO PRISLO
	LXI	D,ERRSOH
	CALL	PRINT_MESSAGE	;"H PRIJMUT, NENI SOH"
	JMP	RECV_SECT_ERR	;A CHYBA PRIJMU

ERRSOH::
	DB	'H prijmut, neni SOH',CR,LF,'$'

;---------------------------------
;PRISEL SOH
GOT_SOH::
	MVI	B,1		;1 SEC TIMEOUT
	CALL	RECV		;PRIJEM BLK
	JC	RECV_HDR_TIMEOUT
	MOV	D,A		;D=BLK (DELKA)
	MVI	B,1		;1 SEC TIMEOUT
	CALL	RECV		;PRIJEM CMA(BLK)
	JC	RECV_HDR_TIMEOUT
	CMA
	CMP	D		;SOUHLASI?
	JZ	RECV_SECTOR	;OK, JDE PAKET

;NESOUHLAS BLK A CMA(BLK)
	LXI	D,ERR2
	CALL	PRINT_MESSAGE	;"Vadny BLK.."
	JMP	RECV_SECT_ERR	;A CHYBA PRIJMU

ERR2::
	DB	'** Vadny BLK v HDR',CR,LF,'$'

;--------------------------------
;HDR OK, JDOU DATA V PAKETU
RECV_SECTOR::
	MOV	A,D		;VEM DELKU 
	STA	RECVD_SECT_NO	;ULOZ
	MVI	C,0		;INIT KONTR. SOUCTU
	LXI	H,80H		;ZACATEK DMA BUFFERU
RECV_CHAR::
	MVI	B,1		;1 SEC TIMEOUT
	CALL	RECV		;CTI ZNAK Z LINKY
	JC	RECV_HDR_TIMEOUT
	MOV	M,A		;ULOZ DO BUFFERU
	INR	L		;PRO DALSI ZNAK
	JNZ	RECV_CHAR	;DOKUD NESTOUPNE NA 100H

;VERIFIKACE KONTROLNIHO SOUCTU
	MOV	D,C		;ULOZ KONTROLNI SOUCET
	MVI	B,1		;1 SEC TIMEOUT
	CALL	RECV		;PRIJMI CHECKSUM
	JC	RECV_HDR_TIMEOUT
	CMP	D		;KOMPARACE
	JNZ	RECV_CKSUM_ERR	;POKUD NESOUHLASI

;PRIJARY SECTOR CHECKSUM OK, ZAPIS HO A DALSI
	LDA	RECVD_SECT_NO
	MOV	B,A		;ULOZ
	LDA	SECTNO		;VEM PREDCHOZI
	INR	A		;NASLEDUJICI SECTOR
	CMP	B		;SHODA?
	JNZ	DO_ACK

;SECTOR OK - ZAPIS HO
	LXI	D,FCB
	MVI	C,WRITE
	CALL	BDOS		;ZAPIS DLE FCB
	ORA	A
	JNZ	WRITE_ERROR	;CHYBA ZAPISU, KONEC
	LDA	RECVD_SECT_NO
	STA	SECTNO		;ULOZ CISLO SECTORU
DO_ACK::
	MVI	A,ACK		;POTVRD CELY SEKTOR
	CALL	SEND		;ODESLI ACK
	JMP	RECV_LOOP	;PRIJMI DALSI

;--------------------------------
WRITE_ERROR::
	CALL	ERXIT

	DB	'** Chyba zapisu do souboru',CR,LF,'$'

;--------------------------------
RECV_CKSUM_ERR::
	LXI	D,ERR3
	CALL	PRINT_MESSAGE	;"SPATNY SOUCET"
	JMP	RECV_SECT_ERR

ERR3::
	DB	'** Spatny kontrolni soucet paketu'
	DB	CR,LF,'$'

;--------------------------------
GOT_EOT::			;KONEC SOUBORU
	MVI	A,ACK
	CALL	SEND		;ODESLI ACK
	LXI	D,FCB
	MVI	C,CLOSE
	CALL	BDOS		;ZAVRI SOUBOR
	INR	A
	JNZ	XFER_CPLT
	CALL	ERXIT		;CHYBA

	DB	'** Chyba uzavreni souboru$'

;--------------------------------
ERASE_OLD_FILE::		;VYMAZ STARY SOUBOR
	LXI	D,FCB
	MVI	C,SRCHF		;EXISTUJE SOUBOR DLE FCB?
	CALL	BDOS
	INR	A		;JE?
	RZ			;NE, RETURN
	LXI	D,EXIST
	CALL	PRINT_MESSAGE	;"STARY VYMAZAN"
ERAY::	CALL	CRLF
	LXI	D,FCB
	MVI	C,ERASE
	CALL	BDOS		;VYMAZ DLE FCB
	RET
;
EXIST::
	DB	'** Stary soubor byl vymazan$'

;--------------------------------
MAKE_NEW_FILE::			;ZALOZ NOVY SOUBOR
	LXI	D,FCB
	MVI	C,MAKE
	CALL	BDOS		;ZALOZ SOUBOR
	INR	A		;FF=CHYBA
	RNZ			;OPEN OK

;PLNY ADRESAR - NEJDE ZALOZIT SOUBOR
	CALL	ERXIT

	DB	'** Nejde zalozit soubor',CR,LF
	DB	'** plny adresar',CR,LF,'$'

;********************************
;
; PODPROGRAMY
;
;********************************
;OPEN FILE
OPEN_FILE::
	LXI	D,FCB
	MVI	C,OPEN		;OTEVRI SOUBOR DLE FCB
	CALL	BDOS
	INR	A		;OPEN OK?
	RNZ			;ANO, SOUBOR JE
	CALL	ERXIT		;SOUBOR NENI

	DB	'** Soubor nejde otevrit$'

;--------------------------------
PRINT_MESSAGE::
	MVI	C,PRINT
	JMP	BDOS		;PRINT, RET Z BDOS

;--------------------------------
;TISK CHYBOVE HLASKY ZA CALL ERXIT A NAVRAT DO CP/M
;--------------------------------
ERXIT::
	POP	D		;VEM MESSAGE
	CALL	PRINT_MESSAGE	;VYTISKNI JI
EXIT::
	LHLD	STACK		;VEM ORIGINAL CP/M STACK
	SPHL			;ULOZ HO
	RET			;--EXIT-- DO CP/M

;********************************
;MODEM PRIJMI ZNAK
;-------------------------------
RECV::
	PUSH	D		;UCHOVEJ KONTR SOUCET
MSEC::
	LXI	D,0BBBBH	;1 SEKUNDA ODPOCET
MWTI::
	MVI	A,00110101B	;RTS=1,ER,RXE,DTR=0
	OUT	CNT_X3
	NOP			;CEKEJ NA UKLIDNENI
	IN	CNT_X3		;STATUS

;SCHODIT RTS ABY PRI CEKANI NEMIZELY ZNAKY
	PUSH	PSW
	MVI	A,00010101B	;RTS=0,ER,RXE,DTR=0
	OUT	CNT_X3
	POP	PSW
	ANI	2
	JNZ	MCHAR		;POKUD JE RxRDT
	DCR	E
	JNZ	MWTI		;ODPOCET PRIBLIZNE 6MS
	DCR	D
	JNZ	MWTI		;ODPOCET 1 SEKUNDA TIMEOUT		
	DCR	B		;DCR POCTU SEKUND
	JNZ	MSEC		;JESTE JSOU SEKUNDY, ZKOUSEJ DAL

;MODEM NEPRIJMUL DO TIMEOUTU
	POP	D		;VRAT KONTR SOUCET
	STC			;NAHOD CARRY ZE BYL TIMEOUT
	RET			

;MODEM MA DATA
MCHAR::
	IN	DAT_X3		;NACTI PRIJATY BYTE
	POP	D		;VRAT KONTR. SOUCET

;PRICTI KE KONTROLNIMU SOUCTU
	PUSH	PSW		;ULOZ PRIJATY BYTE
	ADD	C		;PRICTI PRIJATY K DRIVEJSIMU
	MOV	C,A		;UCHOVEJ V C REGISTRU
	POP	PSW		;OBNOV PRIJATY ZNAK
	ORA	A		;VYNULUJ CARRY, NEBYL TIMEOUT
	RET

;**********************************
;MODEM ODESLI ZNAK
;--------------------------------
SEND::
	PUSH	PSW		;ULOZ VYSILANY ZNAK
	ADD	C		;SPOCITEJ KONRT SOUCET
	MOV	C,A
TX2_1::
	IN	CNT_X3
	RRC
	JNC	TX2_1		;muze USART prijmout z CPU?
	POP	PSW		;VRAT VYSILANY BYTE
	OUT	DAT_X3
	RET

;--------------------------------
;PRINT TIMEOUT ZPRAVY
;--------------------------------
TOUT::
	LXI	D,TOUTM		;"TIMEOUT...
	CALL	PRINT_MESSAGE
PRINT_ERRCT::
	LDA	ERRCT		;POCITADLO CHYB
	CALL	HEXO		;VYPIS KOLIK CHYB

CRLF::
	MVI	A,CR		;VYPIS CR,LF
	CALL	TYPE
	MVI	A,LF

TYPE::
	PUSH	PSW		;VYPIS JEDNOHO ZNAKU
	PUSH	B
	PUSH	D
	PUSH	H
	MOV	E,A
	MVI	C,WRCON
	CALL	BDOS
	POP	H
	POP	D
	POP	B
	POP	PSW
	RET
CR_PR::
	MVI	A,CR		;VYPIS CR,LF
	JMP	TYPE

TOUTM::
	DB	CEOL,'** Timeout $'

;---------------------------------
;VYPIS HEX 
;---------------------------------
HEXO::
	PUSH	PSW		;VYTISKNI HEX CISLO
	RAR
	RAR
	RAR
	RAR
	CALL	NIBBL		;VYSSI
	POP	PSW
NIBBL::
	ANI	0FH
	CPI	10
	JC	ISNUM
	ADI	7
ISNUM::
	ADI	'0'
	JMP	TYPE		;VYPIS JEDNOHO ZNAKU	

;--------------------------------
;MNOHO CHYB, DOTAZ CO DELAT
;----------------------------------
CHECK_FOR_QUIT::
	XRA	A
	STA	ERRCT		;NULUJ POCET CHYB
	LXI	D,QUITM
	CALL	PRINT_MESSAGE	;"MNOHO CHYB.."
	MVI	C,RDCON
	CALL	BDOS		;CTENI KLAVESNICE
	CPI	'`'		;male a-1
	JC	CI1
	ANI	0DFH		;MP NA VP
CI1::
	PUSH	PSW		;ULOZ ZNAK
	CALL	CRLF		;ODRADKUJ
	POP	PSW
	CPI	'O'		;TEST NA OPAKOVAT
	RZ	
	CPI	'K'		;KONEC?
	JNZ	CHECK_FOR_QUIT	;JINY ZNAK, OPAKUJ
	ORA	A		;VYNULUJ ZERO FLAG
	RET

QUITM::
	DB	CR,LF,'** Mnoho chyb.'
	DB	CR,LF,'Zadej K - konec , O - opakovani:$'

;-------------------------------
;PRENESENO,KONEC
;--------------------------------
XFER_CPLT::
	CALL	ERXIT

	DB	CR,LF,'Prenos kompletni',CR,LF,'$'

;**************************************
; PROMENNE
;---------------------------------
	DS	40	;STACK POLE
STACK::
	DS	2	;STACK UKAZATEL
RECVD_SECT_NO::
	DB	0
SECTNO::
	DB	0	;AKTUALNI SECTOR
ERRCT::
	DB	0	;CITAC CHYB
;
;**********************************
	END	100H
