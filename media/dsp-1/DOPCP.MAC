;
; DOPC - Tento CP/M program vysila soubor do PC prostrednictvim seriove
; linky a zapise ho do souboru PC systemu. Program na PC musi poslat soubor
; v formatu XMODEM/protokol. Napriklad Hyperterminal
; Spusteni DOPC xxxxxxxx.xxx
; Prenasi vsechny typy souboru
;
;****************************************
CNT_X2	EQU	49H		;PORTY DSP 1/X2 + X3
DAT_X2	EQU	48H
CNT_X3	EQU	4BH
DAT_X3	EQU	4AH
P_INT	EQU	4CH
;----------------------------------------
ERROR_LIMIT	EQU	9	;MAX POCET CHYB
;----------------------------------------
;DEFINE ASCII CHARACTERS
SOH	EQU	1
EOT	EQU	4
ACK	EQU	6
NAK	EQU	15H
LF	EQU	10
CR	EQU	13
CEOL	EQU	1EH
;-----------------------------------
;
; BDOS KONSTANTY (VER 2.2)
;
RDCON	EQU	1
WRCON	EQU	2
PRINT	EQU	9
CONST	EQU	11	;CONSOLE STATUS
OPEN	EQU	15	;0FFH=NOT FOUND
CLOSE	EQU	16	;   "	"
SRCHF	EQU	17	;   "	"
SRCHN	EQU	18	;   "	"
ERASE	EQU	19	;NEMA NAVR. KOD
READ	EQU	20	;0=OK, 1=EOF (KONEC SOUBORU, POSLEDNI SEKTOR)
WRITE	EQU	21	;0=OK, 1=CHYBA, 2=?, 0FFH=PLNY ADRESAR
MAKE	EQU	22	;0FFH=CHYBA
REN	EQU	23	;0FFH=CHYBA
STDMA	EQU	26
BDOS	EQU	5
REIPL	EQU	0
FCB	EQU	5CH	;SYSTEMOVA FCB
;******************************************

	ASEG
	ORG	100H

	JMP	START

MSG_ID::
	DB	'*** ODESLANI SOUBORU DO PC ***',CR,LF
	DB	'   pres DSP-1/X2 baze 48H',CR,LF
	DB	'      C 25012013 JB',CR,LF,LF,'$'

START::
	LXI	D,MSG_ID	;VYPIS ID ZPRAVU
	CALL	PRINT_MESSAGE

;INIC LOKALNIHO STACKU
	LXI	H,0		;HL=0
	DAD	SP		;HL=STACK SYSTEMU CP/M
	SHLD	STACK		;ULOZ HO
	LXI	SP,STACK	;SP=MUJ STACK PROGRAMU
	CALL	INIT_DSM1	;INICIALIZACE MODEMU

;"VYCISTI" PRIJMOVE REGISTRY 
	MVI	B,1		;TIMEOUT 1 SEK
	CALL	RECV
	MVI	B,1
	CALL	RECV
	JMP	SEND_FILE	;VLASTNI ODESLANI SOUBORU

;********************************
;INICIALIZACE SERIOVEHO PORTU
;--------------------------------
INIT_DSM1::
	LXI	D,MSG_INIT
	CALL	PRINT_MESSAGE	;"9600....
;INIT DSP-1
;nastaveni blokovani preruseni, formovani,
;vnitrni reset, druh provozu, 1.comand 
	
	XRA	A
	OUT	P_INT
	OUT	CNT_X2
	OUT	CNT_X2
	OUT	CNT_X2
	MVI	A,40H		;reset UART
	OUT	CNT_X2
	MVI	A,01001110B	;SB1,P0,B8,x16
	OUT	CNT_X2
	MVI	A,00010101B	;RTS=0,ER=1,DTR=0,RXE,TXEN=1
	OUT	CNT_X2		;signaly na konektoru!!!
	RET

MSG_INIT::
	DB '9600 Bd, 8 bit, 2 stop, parita 0, rizeni RTS',CR,LF,'$'

;*******************************************
;ODESLANI SOUBORU 
;-------------------------------------------
SEND_FILE::
	CALL	OPEN_FILE	;OTEVRI SOUBOR DLE FCB
	LXI	D,OPENM
	CALL	PRINT_MESSAGE
SENDB::
	XRA	A
	STA	ERRCT		;VYNULUJ POCITADLO CHYB

;CTI SECTOR A ODESLI HO JAKO (PAKET)
	CALL	READ_SECTOR
	LDA	SECTNO		;PUVODNI CISLO SEKTORU
	INR	A		;+1
	STA	SECTNO		;ULOZ

;ODESLANI A OPAKOVANI PAKETU
REPTB::
	LXI	D,SECTMSG
	CALL	PRINT_MESSAGE	;"VYSILAM PAKET.."
	LDA	SECTNO		;NACTI JEHO CISLO
	CALL	HEXO		;JEHO CISLO HEX
	CALL	CR_PR		;PRO ODRADKOVANI
	MVI	A,SOH		;KOD ZAHAJENI SOH = 01H
	CALL	SEND		;ODESLI
	LDA	SECTNO
	CALL	SEND		;ODESLI CISLO PAKETU
	LDA	SECTNO
	CMA			;DOPLNEK CISLA PAKETU
	CALL	SEND		;ODESLI DOPLNEK

;ODESLANI 128 BYTE A KONTR SOUCTU
	MVI	C,0		;VYNULUJ KONTROLNI SOUCET
	LXI	H,80H
SENDC::
	MOV	A,M
	CALL	SEND		;POSLI 1 BYTE ZE SOUBORU
	INX	H
	MOV	A,H
	CPI	1		;KONEC SEKTORU V DMA?
	JNZ	SENDC		;POKUD NENI POSLEDNI OPAKUJ

;CELY SEKTOR ODESLAN, JESTE KONTROLNI SUMA
	MOV	A,C
	CALL	SEND		;ODESLANI KONTR. SUMY

;CEKANI NA ACK Z PC
	MVI	B,3		;MAX 3 SEKUND
	CALL	RECV		;PRIJMI ZNAK ACK
	JNC	SNTO		;NEBYL TIMEOUT, POKRACUJ
;--------------------------------

;TIMEOUT PRI CEKANI NA ACK
	CALL	TOUT		;VYPIS "TIMEOUT", ERRCT
DATERR::
	LDA	ERRCT
	INR	A
	STA	ERRCT		;PRICTI POCITADLO CHYB
	CPI	ERROR_LIMIT	;KONTROLA NA MAXIMUM CHYB
	JC	REPTB		;OPAKUJ ODESLANI PAKETU

;VICE POKUSU O ODESLANI NEZ JE LIMIT
	CALL	CHECK_FOR_QUIT
	JZ	REPTB		;OPAKUJ ODESLANI PAKETU
	CALL	ERXIT		;VYPIS A DO CP/M

	DB	'** Nejde vyslat paket - ukoncuji prenos',CR,LF,'$'

SECTMSG::
	DB	' Vysilam paket $'

;---------------------------------
;KONTROLA ZA PAKETEM
;---------------------------------
SNTO::
	CPI	ACK		;ACK PRIJMUT?
	JZ	SENDB		;ANO, ODESLI DALSI SEKTOR

;NECO PRIJATO ALE NENI TO ACK
	CALL	HEXO		;VYPIS CO BYLO PRIJATO 
	LXI	D,ERR1
	CALL	PRINT_MESSAGE	;"H PRIJMUTO,NENI ACK..."
	JMP	DATERR		;GO TO DATA ERROR

ERR1::
	DB	'H prijmuto, neni ACK',CR,LF,'$'

OPENM::
	DB	'Soubor otevren',CR,LF,'$'

;*******************************
;
; PODPROGRAMY
;
;*******************************
;OPEN FILE
OPEN_FILE::
	LXI	D,FCB
	MVI	C,OPEN
	CALL	BDOS
	INR	A		;OPEN OK?
	RNZ			;PRI OK
	CALL	ERXIT		;CHYBA, VYPIS, UKONCENI

	DB	'** Soubor nejde otevrit$'

;--------------------------------
PRINT_MESSAGE::
	MVI	C,PRINT
	JMP	BDOS		;PRINT, RET Z BDOSU

;--------------------------------
;TISK CHYBOVE HLASKY ZA 'CALL ERXIT' A KONEC PROGRAMU
;--------------------------------
ERXIT::
	POP	D		;VEM NAVRATOVOU ADRESU, JE TAM TEXT
	CALL	PRINT_MESSAGE	;VYTISKNI HO
EXIT::
	LHLD	STACK		;NACTI CP/M STACK
	SPHL			;OBNOV CP/M STACK

	RET			;--EXIT-- DO  CP/M

;*********************************
;MODEM PRIJMI ZNAK
;---------------------------------
RECV::
	PUSH	D		;UCHOVEJ KONTR SOUCET
MSEC::
	LXI	D,0BBBBH	;1 SEKUNDA ODPOCET

MWTI::
	MVI	A,00110101B	;RTS=1,ER,RXE,DTR=0
	OUT	CNT_X2
	NOP			;CEKEJ NA UKLIDNENI
	IN	CNT_X2		;STATUS

;SCHODIT RTS ABY PRI CEKANI NEMIZELY ZNAKY
	PUSH	PSW
	MVI	A,00010101B	;RTS=0,ER,RXE,DTR=0
	OUT	CNT_X2
	POP	PSW
	ANI	2
	JNZ	MCHAR		;POKUD JE RxRDT
	DCR	E
	JNZ	MWTI		;ODPOCET PRIBLIZNE 6MS
	DCR	D
	JNZ	MWTI		;ODPOCET 1 SEKUNDA TIMEOUT		
	DCR	B		;DCR POCTU SEKUND
	JNZ	MSEC

;MODEM NEPRIJMUL DO TIMEOUTU
	POP	D		;VRAT KONTR SOUCET
	STC			;NAHOD CARRY ZE BYL TIMEOUT
	RET			

;MODEM MA PLATNA DATA
MCHAR::
	IN	DAT_X2		;NACTI PRIJATY BYTE
	POP	D		;VRAT KONTR. SOUCET

;PRICTI KE KONTROLNIMU SOUCTU
	PUSH	PSW		;ULOZ PRIJATY BYTE
	ADD	C		;PRICTI PRIJATY K DRIVEJSIMU
	MOV	C,A		;UCHOVEJ V C REGISTRU
	POP	PSW		;OBNOV PRIJATY ZNAK
	ORA	A		;VYNULUJ CARRY, NEBYL TIMEOUT
	RET

;**********************************
;MODEM ODESLI ZNAK
;----------------------------------
SEND::
	PUSH	PSW		;ULOZ VYSILANY ZNAK
	ADD	C		;SPOCITEJ KONRT SOUCET
	MOV	C,A
TX2_1::
	IN	CNT_X2
	RRC
	JNC	TX2_1		;muze USART prijmout z CPU?
	POP	PSW		;VRAT VYSILANY BYTE
	OUT	DAT_X2
	RET

;----------------------------------
;TISK TIMEOUT ZPRAVY
;----------------------------------
TOUT::
	LXI	D,TOUTM
	CALL	PRINT_MESSAGE	;"TIMEOUT"
PRINT_ERRCT::
	LDA	ERRCT
	CALL	HEXO		;VYPIS POCET CHYB

CRLF::
	MVI	A,CR		;VYPIS CR,LF
	CALL	TYPE
	MVI	A,LF

TYPE::
	PUSH	PSW
	PUSH	B
	PUSH	D
	PUSH	H
	MOV	E,A
	MVI	C,WRCON
	CALL	BDOS
	POP	H
	POP	D
	POP	B
	POP	PSW
	RET

CR_PR::
	MVI	A,CR		;VYPIS CR,LF
	JMP	TYPE

TOUTM::
	DB	CEOL,'** Timeout $'

;-----------------------------------
;HEX OUTPUT
;-----------------------------------
HEXO::
	PUSH	PSW		;VYTISKNI HEX CISLO
	RAR
	RAR
	RAR
	RAR
	CALL	NIBBL		;VYSSI
	POP	PSW
NIBBL::
	ANI	0FH
	CPI	10
	JC	ISNUM
	ADI	7
ISNUM::
	ADI	'0'
	JMP	TYPE		;VYPIS JEDNOHO ZNAKU

;----------------------------------
;MNOHO CHYB, DOTAZ CO DELAT
;----------------------------------
CHECK_FOR_QUIT::
	XRA	A
	STA	ERRCT		;NULUJ POCET CHYB
	LXI	D,QUITM
	CALL	PRINT_MESSAGE	;"MNOHO CHYB.."
	MVI	C,RDCON
	CALL	BDOS		;CTENI KLAVESNICE
	CPI	'`'		;male a-1
	JC	CI1
	ANI	0DFH		;MP NA VP
CI1::
	PUSH	PSW		;ULOZ ZNAK
	CALL	CRLF		;ODRADKUJ
	POP	PSW
	CPI	'O'		;TEST NA OPAKOVAT
	RZ	
	CPI	'K'		;KONEC?
	JNZ	CHECK_FOR_QUIT	;JINY ZNAK, OPAKUJ
	ORA	A		;VYNULUJ ZERO FLAG
	RET

QUITM::
	DB	CR,LF,'** Mnoho chyb.'
	DB	CR,LF,'Zadej K - konec , O - opakovani:$'

;-----------------------------------
;CTENI CP/M SOUBORU Z DISKU
;-----------------------------------
READ_SECTOR::
	LXI	D,FCB		;CTI SEKTOR PODLE FCB
	MVI	C,READ
	CALL	BDOS
	ORA	A
	RZ			;0 = CTENI OK
	DCR	A		;TEST END OF FILE?
	JNZ	RDERR		;OSTATNI JE CHYBA

;ZPRACOVANI EOF
	XRA	A
	STA	ERRCT		;CELY SOUBOR OK, VYNULUJ CHYBY
	LXI	D,FSENTM 
	CALL	PRINT_MESSAGE	;"SOUBOR ODESLAN...
SEOT::
	MVI	A,EOT
	CALL	SEND		;ODESLI ZAKONCENI EOT
	MVI	B,3		;3 SEC NA TIMEOUT
	CALL	RECV		;CTENI ACK
	JC	EOTTOT		;POKUD JE PO EOT TIMEOUT
	CPI	ACK		;JE PRIJMUTY ACK?
	JZ	XFER_CPLT	;ANO

;NECO PRISLO ALE NENI TO ACK
	CALL	HEXO		;VYPIS CO PRISLO
	LXI	D,ERR1
	CALL	PRINT_MESSAGE	;"H,PRIJATO, NENI ACK"  
EOTERR::
	LDA	ERRCT
	INR	A
	STA	ERRCT		;PRICTI POCITADLO
	CPI	ERROR_LIMIT	;ZKONTROLUJ NA MAXIMUM
	JC	SEOT		;ZKUS ZNOVA ODESLAT EOT
	CALL	ERXIT		;NAD LIMIT VYPIS A KONEC

	DB	'** Neni ACK po odeslani EOT$',LF,CR

FSENTM::
	DB	CR,LF,'Soubor odeslan, odesilam EOT',LF,CR,'$'

;---------------------------------
;TIMEOUT PRI EOT
;---------------------------------
EOTTOT::
	CALL	TOUT
	JMP	EOTERR

;--------------------------------
;READ ERROR
;--------------------------------
RDERR::
	CALL	ERXIT

	DB	'** Chyba cteni souboru$'

;--------------------------------
;PRENESENO,KONEC
;--------------------------------
XFER_CPLT::
	CALL	ERXIT

	DB	CR,LF,'Prenos kompletni',CR,LF,'$'

;**************************************
; PROMENNE
;--------------------------------------
	DS	40	;STACK AREA
STACK::
	DS	2	;STACK POINTER
RECVD_SECT_NO::
	DB	0
SECTNO::
	DB	0	;CURRENT SECTOR NUMBER 
ERRCT::
	DB	0	;ERROR COUNT
;
;**************************************
	END	100H
