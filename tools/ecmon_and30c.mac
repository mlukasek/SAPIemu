;********************************
;
;OVLADAC DISPLEJE AND-30C (MC6845, 80 X 21 ZNAKU)
;
;SAPIemu 2026 misto ovladace AND-1Z v ECMON (tools/ecmon_and30c.py vlozi do ECMONM.MAC J. Biby).
;Ridici kody jako ovladac AND-1Z. Video RAM F800-FE8F (21 radku po 80 znacich, adresa = F800 +
;radek*80 + sloupec), 6845 na FFE0H (adresovy registr) a FFF0H (datovy registr). Kurzor kresli
;a blika 6845 (R14/R15 = adresa - F800H), proto QBLINK nic nedela. Rolovani prenasi LDIR/LDDR
;(Z80, zde jako DB).
;
SHCTRL	EQU	1		;ZOBRAZUJ I KONTROLNI ZNAK (TELEVIDEO GRAFIKA)
LINS	EQU	2		;VLOZENI RADKY
LDEL	EQU	3		;VYMAZ RADKY
ENBL.C	EQU	4		;POVOL CESTINU
DSBL.C	EQU	5		;ZAKAZ CESTINU
BS	EQU	8		;KURZOR ZPET O JEDNU POZICI
TAB	EQU	9		;TABULATOR
LF	EQU	0AH		;NOVY RADEK
CR	EQU	0DH		;NAVRAT KURZORU NA ZACATEK RADKY
ESC	EQU	1BH		;ADRESACE KURZORU Y,X BINARNI + OFFSET DEKADICKY
OFFSET	EQU	32
HOME	EQU	1DH		;HOME
CEOL	EQU	1EH		;VYMAZ DO KONCE RADKY
CLS	EQU	1FH		;NULOVANI OBRAZOVKY OD KURZORU
VT	EQU	0BH		;KURZOR DOLU
CAN	EQU	18H		;KURZOR	VPRAVO
SUB	EQU	1AH		;KURZOR	NAHORU
BELL	EQU	07H		;ZVUKOVY SIGNAL
BEEP	EQU	3000H		;DELKA SIGNALU
;
VRAM	EQU	0F800H		;BAZE ADRESA VIDEO RAM
LINES	EQU	21		;POCET RADEK
CHARS	EQU	80		;POCET ZNAKU/RADEK
VEND	EQU	VRAM+LINES*CHARS	;ZA POSLEDNIM ZNAKEM (FE90H)
CRTCA	EQU	0FFE0H		;6845 ADRESOVY REGISTR (RS = A4 = 0)
CRTCD	EQU	0FFF0H		;6845 DATOVY REGISTR (RS = A4 = 1)
;------------------------
.CONOUT:			;VETVENI PODLE IOBYTE
	lda	iobyte
	ani	dmsk		;00000010b
	jnz	dsmout		;SKOK POKUD JE UC1:
	LDA	IOBYTE
	ANI	COMSK		;00000001B
	JNZ	crtout		;SKOK POKUD JE CRT:
	PUSH	B
	CALL	.LSTOUT		;POKUD JE TTY, POSLI I NA LST:
	POP	B		;A ZAROVEN NA CRT:
;*******************************
CRTOUT:
	LHLD	CUR.ADR
	LDA	LEAD
	DCR	A
	JP	INLEAD
	LDA	IGN.CTRL
	ORA	A
	JZ	CHKCTL
	XRA	A
	STA	IGN.CTRL
	MOV	A,C
	JMP	PUTCH
CHKCTL:	MOV	A,C
	CPI	' '
	JC	CTRLCH
;-------------------------------
PUTCH:	MOV	M,A
	INX	H
	CALL	COLUMN		;A = SLOUPEC NOVE POZICE
	CPI	CHARS
	JC	SETCUR
	CALL	LBEG		;ZA KONCEM RADKU: ZACATEK DALSIHO
	XCHG
	JMP	LFEED
;===============================
INLEAD:	STA	LEAD		;ESC Y X
	JZ	YADR
	MOV	A,C		;RADEK
	SUI	OFFSET
	JM	INLEA1
	CPI	LINES
	JC	INLEA2
INLEA1:	XRA	A
INLEA2:	STA	XADR
	RET
YADR:	MOV	A,C		;SLOUPEC
	SUI	OFFSET
	CPI	CHARS
	JC	YADR1
	XRA	A
YADR1:	PUSH	PSW
	LDA	XADR
	STA	CUR.LINE
	CALL	ROWADR
	POP	PSW
	MOV	E,A
	MVI	D,0
	DAD	D
	JMP	SETCUR
;===============================
CTRLCH:	CPI	SHCTRL		;PREFIX TELEVIDEO
	JNZ	QBS
	STA	IGN.CTRL
	RET
QBS:	CPI	BS		;KURZOR O JEDNU POZICI ZPET
	JNZ	QTAB
	CALL	COLUMN
	ORA	A
	JNZ	QBS1
	LDA	CUR.LINE	;ZE ZACATKU RADKU NA KONEC PREDCHOZIHO
	ORA	A
	RZ
	DCR	A
	STA	CUR.LINE
QBS1:	DCX	H
	JMP	SETCUR
QTAB:	CPI	TAB		;TABULATOR PO 8, NECHODI PRES RADKU
	JNZ	QLF
	CALL	COLUMN
	ADI	8
	ANI	0F8H
	CPI	CHARS
	RNC
	MOV	L,A
	MVI	H,0
	DAD	D
	JMP	SETCUR
QLF:	CPI	LF		;NOVY RADEK
	JZ	LFEED
	CPI	CR		;NAVRAT NA ZACATEK RADKY
	JNZ	QHOME
	CALL	LBEG
	XCHG
	JMP	SETCUR
QHOME:	CPI	HOME
	JNZ	QESC
	LXI	H,VRAM
	XRA	A
	STA	CUR.LINE
	JMP	SETCUR
QESC:	CPI	ESC
	JNZ	QCEOL
	MVI	A,2
	STA	LEAD
	RET
QCEOL:	CPI	CEOL		;VYMAZ DO KONCE RADKY
	JNZ	QLINS
	CALL	COLUMN
	MOV	B,A
	MVI	A,CHARS
	SUB	B
	MOV	B,A
	PUSH	H
CEOL1:	MVI	M,' '
	INX	H
	DCR	B
	JNZ	CEOL1
	POP	H
	RET
QLINS:	CPI	LINS		;VLOZENI RADKY NA MISTE KURZORU
	JNZ	QLDEL
	PUSH	H
	CALL	NROWS
	JZ	LINS1
	CALL	MUL80
	LXI	H,VEND-CHARS-1
	LXI	D,VEND-1
	DB	0EDH,0B8H	;LDDR
LINS1:	LDA	CUR.LINE
	JMP	LDEL2
QLDEL:	CPI	LDEL		;VYMAZ RADKY KURZORU
	JNZ	QCLS
	PUSH	H
	CALL	NROWS
	JZ	LDEL1
	CALL	MUL80
	LDA	CUR.LINE
	CALL	ROWADR
	MOV	D,H
	MOV	E,L
	PUSH	B
	LXI	B,CHARS
	DAD	B
	POP	B
	DB	0EDH,0B0H	;LDIR
LDEL1:	MVI	A,LINES-1
LDEL2:	CALL	BLANKR
	POP	H
	RET
QCLS:	CPI	CLS		;NULOVANI OBRAZOVKY OD KURZORU
	JNZ	QENBL
	PUSH	H
CLS1:	MVI	M,' '
	INX	H
	MOV	A,L
	CPI	LOW VEND
	JNZ	CLS1
	MOV	A,H
	CPI	HIGH VEND
	JNZ	CLS1
	POP	H
	RET
QENBL:	CPI	ENBL.C
	JNZ	QDSBL
	STA	C.ENBL
	RET
QDSBL:	CPI	DSBL.C
	JNZ	QCAN
	XRA	A
	STA	C.ENBL
	RET
QCAN:	CPI	CAN		;KURZOR ->
	JNZ	QSUB
	CALL	COLUMN
	CPI	CHARS-1
	JC	QCAN1
	LDA	CUR.LINE
	CPI	LINES-1
	RNC
	INR	A
	STA	CUR.LINE
QCAN1:	INX	H
	JMP	SETCUR
QSUB:	CPI	SUB		;KURZOR ^
	JNZ	QVT
	LDA	CUR.LINE
	ORA	A
	RZ
	DCR	A
	STA	CUR.LINE
	LXI	D,-CHARS
	DAD	D
	JMP	SETCUR
QVT:	CPI	VT		;KURZOR DOLU (BEZ ROLOVANI)
	JNZ	QBELL
	LDA	CUR.LINE
	CPI	LINES-1
	RNC
	INR	A
	STA	CUR.LINE
	LXI	D,CHARS
	DAD	D
	JMP	SETCUR
QBELL:	CPI	BELL
	RNZ
	LXI	B,BEEP
ALARM:	XRA	A		;PIPNUTI KLAVESNICE
	OUT	P0
	DCX	B
	MOV	A,B
	ORA	C
	JNZ	ALARM
	MVI	A,AC
	OUT	P0
	RET
;********************************
;	PODPROGRAMY OVLADACE AND-30C
;********************************
LFEED:	LDA	CUR.LINE	;RADEK DOLU, NA POSLEDNIM ROLUJ
	CPI	LINES-1
	JC	LFEED1
	PUSH	H
	LXI	H,VRAM+CHARS
	LXI	D,VRAM
	LXI	B,(LINES-1)*CHARS
	DB	0EDH,0B0H	;LDIR
	MVI	A,LINES-1
	CALL	BLANKR
	POP	H
	JMP	SETCUR
LFEED1:	INR	A
	STA	CUR.LINE
	LXI	D,CHARS
	DAD	D
;-------------------------------
SETCUR:	SHLD	CUR.ADR		;KURZOR 6845 NA HL
	MVI	A,14
	STA	CRTCA
	MOV	A,H
	ANI	07H		;HL - F800H
	STA	CRTCD
	MVI	A,15
	STA	CRTCA
	MOV	A,L
	STA	CRTCD
QBLINK:	RET			;KURZOR BLIKA 6845
;-------------------------------
COLUMN:	CALL	LBEG		;A = SLOUPEC HL, DE = ZACATEK RADKU CUR.LINE
	MOV	A,L
	SUB	E
	RET
LBEG:	PUSH	H		;DE = ZACATEK RADKU CUR.LINE
	LDA	CUR.LINE
	CALL	ROWADR
	XCHG
	POP	H
	RET
NROWS:	LDA	CUR.LINE	;A = RADKU POD KURZOREM, ZF KDYZ ZADNY
	MOV	B,A
	MVI	A,LINES-1
	SUB	B
	RET
MUL80:	CALL	ROWOFF		;BC = A*CHARS
	MOV	B,H
	MOV	C,L
	RET
ROWADR:	CALL	ROWOFF		;HL = VRAM + A*CHARS
	LXI	D,VRAM
	DAD	D
	RET
ROWOFF:	MOV	L,A		;HL = A*CHARS (80 = 16 + 64)
	MVI	H,0
	DAD	H
	DAD	H
	DAD	H
	DAD	H
	MOV	D,H
	MOV	E,L
	DAD	H
	DAD	H
	DAD	D
	RET
BLANKR:	CALL	ROWADR		;VYMAZ RADEK A
	MVI	B,CHARS
BLANK1:	MVI	M,' '
	INX	H
	DCR	B
	JNZ	BLANK1
	RET
;-------------------------------
CRTINI:	LXI	H,CRTTAB	;NASTAVENI 6845 (VOLA CINIT)
	MVI	C,0
CRTIN1:	MOV	A,C
	STA	CRTCA
	MOV	A,M
	STA	CRTCD
	INX	H
	INR	C
	MOV	A,C
	CPI	16
	JNZ	CRTIN1
	RET
;ZNAK 1,8 MHZ (10,8 MHZ / 6): RADEK 115 ZNAKU = 63,9 US (15,65 KHZ), 312 RADKU = 50,2 HZ
CRTTAB:	DB	114,CHARS,89,8	;R0-R3: CELKEM, ZOBRAZENO, POLOHA HS, SIRKA HS 4,4 US
	DB	25,0,LINES,23	;R4-R7: 26 RADKU ZNAKU, KOREKCE, ZOBRAZENO, POLOHA VS
	DB	0,11,4AH,11	;R8-R11: BEZ PROKLADANI, 12 RADKU ZNAKU, KURZOR RADKY 10-11 BLIKA
	DB	0,0,0,0		;R12-R15: ZACATEK, KURZOR
